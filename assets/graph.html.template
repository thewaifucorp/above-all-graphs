// --- Mode + URL state --------------------------------------------------------
// One store, one writer. Every state worth sharing lives in the query string,
// so any view can be pasted into a review — schema in
// `docs/graph-experience.md`.
const MODE_LIST = [
  { id: "overview", label: "Overview", hint: "Modules and how they connect" },
  { id: "explore", label: "Explore", hint: "One symbol and its neighbourhood" },
  { id: "path", label: "Path", hint: "How one symbol reaches another" },
  { id: "impact", label: "Impact", hint: "What breaks if this changes" },
  { id: "contracts", label: "Contracts", hint: "Endpoints, schemas, and who serves them" },
];
const MODE_IDS = MODE_LIST.map((mode) => mode.id);

const State = {
  mode: "overview",
  focus: null,
  from: null,
  to: null,
  up: 1,
  down: 1,
  community: null,
  expanded: new Set(),
  rel: null,
  conf: null,
  kind: null,
  pins: new Set(),
  arrowsOnly: false,
  routes: 4,
  cam: null,
};

const ALL_REL = [...new Set(links.map((edge) => edge.kind))];
const ALL_CONF = [...new Set(links.map((edge) => edge.confidence))];
const ALL_KIND = [...new Set(nodes.map((node) => node.kind))];
/// The kinds that hold other code rather than being held: what a reader means by
/// "which files talk to which". `Structure only` narrows the graph to these, so
/// the import and reference skeleton is readable without the thousand functions
/// hanging off it.
const CONTAINER_KINDS = ["file", "doc", "schema", "database_table", "infra_resource", "endpoint"];
const containersOnly = () =>
  !!State.kind && ALL_KIND.every((kind) => State.kind.has(kind) === CONTAINER_KINDS.includes(kind));

function parseSet(value, cast) {
  if (!value) return null;
  const parts = value.split(",").map((part) => part.trim()).filter(Boolean);
  return parts.length ? new Set(cast ? parts.map(cast) : parts) : null;
}
/// How many routes the path search will enumerate at most. Yen's algorithm runs
/// one breadth-first search per spur node per accepted route, so the cost grows
/// with this; twelve routes on a repository-sized graph is still milliseconds,
/// and a scene with more than that in it stops being readable anyway.
const MAX_ROUTES = 12;

const clampRoutes = (value, fallback) => {
  if (value === null || value === undefined || value === "") return fallback;
  const parsed = Number(value);
  return Number.isFinite(parsed) ? Math.max(1, Math.min(MAX_ROUTES, Math.round(parsed))) : fallback;
};

const clampDepth = (value, fallback) => {
  // `Number(null)` is 0, not NaN, so an absent parameter would silently read
  // as depth zero and show a lone node.
  if (value === null || value === undefined || value === "") return fallback;
  const parsed = Number(value);
  return Number.isFinite(parsed) ? Math.max(0, Math.min(6, Math.round(parsed))) : fallback;
};

function readUrl() {
  const query = new URLSearchParams(location.search);
  const mode = query.get("mode");
  State.mode = MODE_IDS.includes(mode) ? mode : query.get("focus") ? "explore" : "overview";
  State.focus = query.get("focus") || null;
  State.from = query.get("from") || null;
  State.to = query.get("to") || null;
  State.up = clampDepth(query.get("up"), 1);
  State.down = clampDepth(query.get("down"), 1);
  State.community = query.has("community") ? Number(query.get("community")) : null;
  State.expanded = parseSet(query.get("expanded"), Number) || new Set();
  State.rel = parseSet(query.get("rel"));
  State.conf = parseSet(query.get("conf"), (value) => value.toUpperCase());
  State.kind = parseSet(query.get("kind"));
  State.pins = parseSet(query.get("pin"), Number) || new Set();
  State.arrowsOnly = query.get("dir") === "arrows";
  State.routes = clampRoutes(query.get("routes"), 4);
  const cam = query.get("cam");
  if (cam) {
    const [x, y, ratio] = cam.split(",").map(Number);
    State.cam = [x, y, ratio].every(Number.isFinite) ? { x, y, ratio } : null;
  } else {
    State.cam = null;
  }
}

function writeUrl(push) {
  const query = new URLSearchParams();
  query.set("mode", State.mode);
  if (State.focus) query.set("focus", State.focus);
  if (State.from) query.set("from", State.from);
  if (State.to) query.set("to", State.to);
  if (State.up !== 1) query.set("up", String(State.up));
  if (State.down !== 1) query.set("down", String(State.down));
  if (State.community !== null) query.set("community", String(State.community));
  if (State.expanded.size) query.set("expanded", [...State.expanded].sort((a, b) => a - b).join(","));
  if (State.rel) query.set("rel", [...State.rel].join(","));
  if (State.conf) query.set("conf", [...State.conf].join(","));
  if (State.kind) query.set("kind", [...State.kind].join(","));
  if (State.pins.size) query.set("pin", [...State.pins].join(","));
  if (State.arrowsOnly) query.set("dir", "arrows");
  if (State.routes !== 4) query.set("routes", String(State.routes));
  if (State.cam) query.set("cam", `${State.cam.x.toFixed(4)},${State.cam.y.toFixed(4)},${State.cam.ratio.toFixed(4)}`);
  const url = `${location.pathname}?${query.toString()}`;
  // A mode or focus change is a navigation; a filter tweak is not, or the back
  // button would walk one checkbox at a time.
  if (push) history.pushState(null, "", url);
  else history.replaceState(null, "", url);
}

function setState(patch, options) {
  const cameraKept = patch && Object.prototype.hasOwnProperty.call(patch, "cam");
  if (!cameraKept) State.cam = null;
  Object.assign(State, patch);
  writeUrl(options && options.push);
  applyState();
}

// Filters are stored as what is allowed; the reducers work on what is hidden.
let hiddenKinds = new Set();
let hiddenConf = new Set();
let hiddenRel = new Set();
let searchQuery = "";

function syncFilterSets() {
  hiddenKinds = new Set(State.kind ? ALL_KIND.filter((kind) => !State.kind.has(kind)) : []);
  hiddenConf = new Set(State.conf ? ALL_CONF.filter((conf) => !State.conf.has(conf)) : []);
  hiddenRel = new Set(State.rel ? ALL_REL.filter((rel) => !State.rel.has(rel)) : []);
}

function buildModeSwitcher() {
  const host = document.getElementById("modes");
  host.innerHTML = MODE_LIST.map(
    (mode, index) =>
      `<button role="tab" data-mode="${mode.id}" aria-selected="false" title="${escapeHtml(mode.hint)} (${index + 1})">${mode.label}</button>`
  ).join("");
  for (const button of host.querySelectorAll("button")) {
    button.addEventListener("click", () => enterMode(button.dataset.mode));
  }
}

function enterMode(mode) {
  if (!MODE_IDS.includes(mode) || mode === State.mode) return;
  setState({ mode }, { push: true });
}

let noticeTimer = null;
// A shared link can name a symbol that has since been renamed or deleted, and
// a scene can be capped. Say so — degrading silently is how a reader concludes
// the tool is broken.
function notice(message) {
  const host = document.getElementById("notice");
  if (!message) {
    host.hidden = true;
    return;
  }
  host.textContent = message;
  host.hidden = false;
  clearTimeout(noticeTimer);
  noticeTimer = setTimeout(() => {
    host.hidden = true;
  }, 6000);
}

function resolveFocus(value) {
  if (value === null || value === undefined || value === "") return null;
  const numeric = Number(value);
  if (Number.isInteger(numeric) && byId.has(numeric)) return byId.get(numeric);
  const exact =
    nodes.find((node) => node.file === value && node.kind === "file") ||
    nodes.find((node) => node.name === value) ||
    nodes.find((node) => node.file === value);
  if (exact) return exact;
  // Typing is not dictation. `bigbang` should find `src/bigbang.rs`, and case
  // should not decide whether a path resolves. Most connected wins, so the
  // loose match lands on the symbol someone probably meant.
  const lowered = String(value).toLowerCase();
  const candidates = nodes.filter(
    (node) =>
      (node.name || "").toLowerCase() === lowered ||
      (node.file || "").toLowerCase() === lowered ||
      (node.file || "").toLowerCase().endsWith(`/${lowered}`) ||
      (node.kind === "file" && (node.file || "").toLowerCase().split("/").pop()?.split(".")[0] === lowered)
  );
  if (!candidates.length) return null;
  return candidates.reduce((best, node) => ((node.degree || 0) > (best.degree || 0) ? node : best));
}

// --- Inspector ---------------------------------------------------------------
// One panel for symbols, aggregates, paths, and contracts, because a reader
// should not have to learn a second place to look.
function inspect(key) {
  const attributes = scene.getNodeAttributes(key);
  if (attributes._overflow) {
    inspectOverflow(attributes._overflow);
    return;
  }
  if (attributes._aggregate) {
    inspectAggregate(attributes._aggregate);
    return;
  }
  const node = attributes._node;
  if (!node) return;
  selected = node;
  renderer.refresh();
  inspectNode(node, attributes);
}

function factRow(term, value) {
  return `<dt>${term}</dt><dd>${value}</dd>`;
}

function relationRows(list, label) {
  if (!list.length) return "";
  const rows = list
    .slice(0, 12)
    .map((entry) => {
      const other = entry.node;
      return (
        `<div class="callrow" data-node="${other.id}" tabindex="0" role="button">` +
        `<span class="cname">${escapeHtml(nodeLabel(other))}</span>` +
        `<span class="cfile">${escapeHtml(entry.edge.kind)} · ${entry.edge.confidence.toLowerCase()} · ${escapeHtml(other.file)}</span></div>`
      );
    })
    .join("");
  const more = list.length > 12 ? `<p class="cc-note">${list.length - 12} more</p>` : "";
  return `<h4>${label} (${list.length})</h4>${rows}${more}`;
}

function inspectNode(node, attributes) {
  const panel = document.getElementById("panel");
  const callers = (incoming.get(node.id) || [])
    .filter(edgeAllowed)
    .map((edge) => ({ edge, node: byId.get(edge.source) }))
    .filter((entry) => entry.node);
  const callees = (outgoing.get(node.id) || [])
    .filter(edgeAllowed)
    .map((edge) => ({ edge, node: byId.get(edge.target) }))
    .filter((entry) => entry.node);
  const meta = communityMeta[node.community] || {};
  const impact = attributes && attributes._impact;
  panel.innerHTML = `
    <h3>${escapeHtml(nodeLabel(node))}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(node.community)}"></span>${escapeHtml(meta.label || "unconnected")}</p>
    <dl class="agg-facts">
      ${factRow("kind", escapeHtml(node.kind))}
      ${factRow("location", `${escapeHtml(node.file)}:${node.startLine}`)}
      ${factRow("perspective", escapeHtml(node.perspective || "observed"))}
      ${factRow("degree", node.degree || 0)}
      ${factRow("incoming / outgoing", `${callers.length} / ${callees.length}`)}
      ${ENTRYPOINTS.has(node.id) ? factRow("entrypoint", "yes") : ""}
      ${impact ? factRow("impact", escapeHtml(impact)) : ""}
    </dl>
    <div class="agg-actions">
      <button data-act="explore">Explore here</button>
      <button data-act="impact">Impact</button>
      <button data-act="path-from">Path from</button>
      <button data-act="path-to">Path to</button>
      <button data-act="pin">${State.pins.has(node.id) ? "Unpin" : "Pin"}</button>
      <button data-act="source">Open source</button>
      <a href="wiki/${wikiSlug(node.file)}.html">wiki</a>
    </div>
    ${relationRows(callers, "Incoming")}
    ${relationRows(callees, "Outgoing")}
  `;
  panel.classList.add("open");
  const act = {
    explore: () => setState({ mode: "explore", focus: String(node.id) }, { push: true }),
    impact: () => setState({ mode: "impact", focus: String(node.id) }, { push: true }),
    "path-from": () => setState({ mode: "path", from: String(node.id) }, { push: true }),
    "path-to": () => setState({ mode: "path", to: String(node.id) }, { push: true }),
    pin: () => {
      const pins = new Set(State.pins);
      pins.has(node.id) ? pins.delete(node.id) : pins.add(node.id);
      setState({ pins });
      // The panel was built before the toggle, so its button would keep
      // offering "Pin" for a node that is now pinned.
      inspectNode(node, attributes);
    },
    source: () => openFile(node.file, node.startLine, node.endLine),
  };
  for (const button of panel.querySelectorAll("[data-act]")) {
    button.addEventListener("click", () => act[button.dataset.act] && act[button.dataset.act]());
  }
  for (const row of panel.querySelectorAll("[data-node]")) {
    const go = () => {
      const target = byId.get(Number(row.dataset.node));
      if (target) setState({ mode: "explore", focus: String(target.id) }, { push: true });
    };
    row.addEventListener("click", go);
    row.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        go();
      }
    });
  }
}

// The scene cap is a budget, not a judgement: say exactly what it held back
// and offer to show it.
function inspectOverflow(overflow) {
  const panel = document.getElementById("panel");
  const meta = communityMeta[overflow.community] || {};
  const rows = overflow.members
    .slice(0, 20)
    .map((id) => byId.get(id))
    .filter(Boolean)
    .map(
      (node) =>
        `<div class="callrow" data-node="${node.id}" tabindex="0" role="button"><span class="cname">${escapeHtml(nodeLabel(node))}</span><span class="cfile">${escapeHtml(node.file)}</span></div>`
    )
    .join("");
  panel.innerHTML = `
    <h3>${overflow.members.length} more in ${escapeHtml(meta.label || "#" + overflow.community)}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(overflow.community)}"></span>held back by the ${MAX_SCENE_NODES}-node scene cap</p>
    <div class="agg-actions">
      <button data-act="expand">Show them</button>
    </div>
    ${rows}
    ${overflow.members.length > 20 ? `<p class="cc-note">${overflow.members.length - 20} not listed</p>` : ""}
  `;
  panel.classList.add("open");
  panel.querySelector('[data-act="expand"]').addEventListener("click", () => {
    const expanded = new Set(State.expanded);
    expanded.add(overflow.community);
    setState({ expanded });
  });
  for (const row of panel.querySelectorAll("[data-node]")) {
    row.addEventListener("click", () => setState({ focus: row.dataset.node }, { push: true }));
  }
}

function inspectAggregate(community) {
  const panel = document.getElementById("panel");
  const meta = communityMeta[community.id] || {};
  const total = community.internalEdges + community.externalEdges;
  const cohesion = total ? Math.round((community.internalEdges / total) * 100) : 0;
  const representatives = community.representatives
    .map((id) => byId.get(id))
    .filter(Boolean)
    .map(
      (node) =>
        `<div class="callrow" data-node="${node.id}" tabindex="0" role="button"><span class="cname">${escapeHtml(nodeLabel(node))}</span><span class="cfile">${escapeHtml(node.file)}</span></div>`
    )
    .join("");
  const bundles = BUNDLES.filter((bundle) => bundle.a === community.id || bundle.b === community.id)
    .sort((left, right) => right.count - left.count)
    .slice(0, 8)
    .map((bundle) => {
      const other = bundle.a === community.id ? bundle.b : bundle.a;
      const otherMeta = communityMeta[other] || {};
      return `<div class="callrow"><span class="cname">${bundle.kind} &times;${bundle.count}</span><span class="cfile">${escapeHtml(otherMeta.label || "#" + other)} · ${bundle.ambiguous} ambiguous</span></div>`;
    })
    .join("");
  panel.innerHTML = `
    <h3>${escapeHtml(meta.label || "#" + community.id)}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(community.id)}"></span>module aggregate</p>
    <dl class="agg-facts">
      ${factRow("symbols", community.members.length)}
      ${factRow("internal edges", community.internalEdges)}
      ${factRow("external edges", community.externalEdges)}
      ${factRow("cohesion", `${cohesion}%`)}
      ${factRow("entrypoints", community.entrypoints)}
      ${factRow("worst confidence", String(community.worstConfidence || "").toLowerCase())}
    </dl>
    <div class="agg-actions">
      <button data-act="toggle">${State.expanded.has(community.id) ? "Collapse" : "Expand"} in place</button>
      <button data-act="isolate">${State.community === community.id ? "Show all" : "Isolate"}</button>
      <button data-act="explore">Explore this module</button>
    </div>
    ${representatives ? `<h4>Most connected</h4>${representatives}` : ""}
    ${bundles ? `<h4>Connects to</h4>${bundles}` : ""}
  `;
  panel.classList.add("open");
  const act = {
    toggle: () => {
      const expanded = new Set(State.expanded);
      expanded.has(community.id) ? expanded.delete(community.id) : expanded.add(community.id);
      setState({ expanded });
    },
    isolate: () => setState({ community: State.community === community.id ? null : community.id }),
    explore: () => {
      const target = byId.get(community.representatives[0]);
      setState({ mode: "explore", focus: target ? String(target.id) : null, community: community.id }, { push: true });
    },
  };
  for (const button of panel.querySelectorAll("[data-act]")) {
    button.addEventListener("click", () => act[button.dataset.act] && act[button.dataset.act]());
  }
  for (const row of panel.querySelectorAll("[data-node]")) {
    row.addEventListener("click", () => {
      const target = byId.get(Number(row.dataset.node));
      if (target) setState({ mode: "explore", focus: String(target.id), community: community.id }, { push: true });
    });
  }
}

// --- Mode chrome -------------------------------------------------------------
// Depth and endpoint controls belong to the modes that use them, and appear
// only there.
function renderModeControls() {
  const host = document.getElementById("mode-controls");
  const parts = [];
  if (State.mode === "explore" || State.mode === "impact") {
    parts.push(
      `<label>upstream <input id="ctl-up" type="number" min="0" max="6" value="${State.up}"></label>`,
      `<label>downstream <input id="ctl-down" type="number" min="0" max="6" value="${State.down}"></label>`
    );
  }
  if (State.mode === "path") {
    // A typed endpoint that resolves to nothing used to blank the field, which
    // reads as "the app ate my input". Keep the text and let the scene explain.
    const name = (value) => {
      if (!value) return "";
      const node = resolveFocus(value);
      return node ? node.name || node.file : String(value);
    };
    // Typing an exact symbol name from memory is not a user interface. The
    // same list the search box uses backs both endpoints, and "use selection"
    // fills one from whatever is currently selected.
    parts.push(
      `<label>from <input id="ctl-from" type="text" list="node-names" value="${escapeHtml(name(State.from))}" placeholder="symbol or file"></label>`,
      `<button id="ctl-from-sel" title="use the selected node">&#8593;</button>`,
      `<label>to <input id="ctl-to" type="text" list="node-names" value="${escapeHtml(name(State.to))}" placeholder="symbol or file"></label>`,
      `<button id="ctl-to-sel" title="use the selected node">&#8593;</button>`,
      `<button id="ctl-swap" title="swap the endpoints">&#8646;</button>`,
      `<label>routes <input id="ctl-routes" type="number" min="1" max="${MAX_ROUTES}" value="${State.routes}"></label>`,
      `<button id="ctl-dir" aria-pressed="${!State.arrowsOnly}" ` +
        `title="fall back to ignoring edge direction when no route follows the arrows, or refuse to">` +
        `${State.arrowsOnly ? "arrows only" : "any direction"}</button>`
    );
  }
  parts.push(
    `<button id="ctl-containers" aria-pressed="${containersOnly()}" ` +
      `title="show only files, docs and other containers, or every symbol">` +
      `${containersOnly() ? "structure only" : "all symbols"}</button>`
  );
  if (State.mode === "overview") {
    const total = communityMeta.filter((meta) => meta.id !== UNGROUPED && meta.size > 0).length;
    const allOpen = State.expanded.size >= total && total > 0;
    parts.push(
      `<button id="ctl-expand-all">${allOpen ? "Collapse all" : "Expand all"} modules</button>`,
      `<span class="ctl-note">${State.expanded.size}/${total} expanded &middot; click a bubble to open it</span>`
    );
  }
  host.innerHTML = parts.join("");
  host.hidden = !parts.length;
  const bind = (id, apply) => {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener("change", () => apply(input.value));
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") apply(input.value);
    });
  };
  bind("ctl-up", (value) => setState({ up: clampDepth(value, State.up) }));
  bind("ctl-down", (value) => setState({ down: clampDepth(value, State.down) }));
  bind("ctl-routes", (value) => setState({ routes: clampRoutes(value, State.routes) }));
  bind("ctl-from", (value) => setState({ from: value || null }, { push: true }));
  bind("ctl-to", (value) => setState({ to: value || null }, { push: true }));

  const useSelection = (field) => {
    if (!selected) {
      notice("Select a node first, then use the arrow to make it an endpoint.");
      return;
    }
    setState({ [field]: String(selected.id) }, { push: true });
  };
  document.getElementById("ctl-from-sel")?.addEventListener("click", () => useSelection("from"));
  document.getElementById("ctl-to-sel")?.addEventListener("click", () => useSelection("to"));
  document
    .getElementById("ctl-swap")
    ?.addEventListener("click", () => setState({ from: State.to, to: State.from }, { push: true }));
  document
    .getElementById("ctl-dir")
    ?.addEventListener("click", () => setState({ arrowsOnly: !State.arrowsOnly }, { push: true }));

  document.getElementById("ctl-containers")?.addEventListener("click", () => {
    setState({
      kind: containersOnly() ? null : new Set(ALL_KIND.filter((kind) => CONTAINER_KINDS.includes(kind))),
    });
  });
  document.getElementById("ctl-expand-all")?.addEventListener("click", () => {
    const all = communityMeta.filter((meta) => meta.id !== UNGROUPED && meta.size > 0);
    const open = State.expanded.size >= all.length && all.length > 0;
    if (!open && nodes.length > WHOLE_GRAPH_WARN) {
      // Expanding everything means rendering everything. On a repository this
      // size that is seconds of layout and a scene nobody can read, so say so
      // rather than appearing to hang.
      notice(`Opening all ${nodes.length.toLocaleString()} nodes — this will be slow and dense.`);
    }
    setState({ expanded: open ? new Set() : new Set(all.map((meta) => meta.id)) });
  });
}

/// Every node name, once, for the endpoint pickers. Built lazily because a
/// large repository has tens of thousands of them and the list is only needed
/// when someone opens Path.
let nodeNameList = null;
function ensureNodeNameList() {
  if (nodeNameList) return;
  nodeNameList = document.createElement("datalist");
  nodeNameList.id = "node-names";
  const seen = new Set();
  const options = [];
  for (const node of nodes) {
    const label = node.name || node.file;
    if (!label || seen.has(label)) continue;
    seen.add(label);
    options.push(`<option value="${escapeHtml(label)}"></option>`);
    if (options.length >= 4000) break;
  }
  nodeNameList.innerHTML = options.join("");
  document.body.appendChild(nodeNameList);
}

const SPEC_BUILDERS = {
  overview: overviewSpec,
  explore: exploreSpec,
  path: pathSpec,
  impact: impactSpec,
  contracts: contractsSpec,
};

function applyState() {
  syncFilterSets();
  document.body.dataset.mode = State.mode;
  document.getElementById("legend").hidden = State.mode !== "overview";
  for (const button of document.querySelectorAll("#modes button")) {
    button.setAttribute("aria-selected", String(button.dataset.mode === State.mode));
  }
  if (State.mode === "path") ensureNodeNameList();
  renderModeControls();
  if (State.mode === "overview") buildLegend();
  if (State.focus && !resolveFocus(State.focus)) {
    notice(`No node named "${State.focus}" in this graph.`);
  }
  renderScene((SPEC_BUILDERS[State.mode] || overviewSpec)()).catch((error) => {
    // A render that throws must not take the rest of the page with it.
    notice(`Could not draw this view: ${error}`);
  });
  markTreeActive();
}

window.addEventListener("popstate", () => {
  readUrl();
  applyState();
});

// --- Legend ------------------------------------------------------------------
function buildLegend() {
  const host = document.getElementById("legend-list");
  const ranked = communityMeta
    .filter((meta) => meta.id !== UNGROUPED && meta.size > 0)
    .slice()
    .sort((left, right) => right.size - left.size)
    .slice(0, 40);
  host.innerHTML = ranked
    .map(
      (meta) =>
        `<div class="row${State.community === meta.id ? " on" : ""}" data-c="${meta.id}" tabindex="0" role="button" title="${escapeHtml(meta.name)}">` +
        `<span class="swatch" style="background:${communityColor(meta.id)}"></span>` +
        `<span class="name">${escapeHtml(meta.label)}</span><span class="n">${meta.size}</span></div>`
    )
    .join("");
  for (const row of host.querySelectorAll(".row")) {
    const toggle = () => {
      const id = Number(row.dataset.c);
      setState({ community: State.community === id ? null : id });
    };
    row.addEventListener("click", toggle);
    row.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggle();
      }
    });
  }
}

// --- Sidebar -----------------------------------------------------------------
// Ranked, not alphabetical: a real repository opens on `.github/` and
// `.history/` when the tree is sorted by name, which buries the source.
/// How many rows the file tree will build. Past this the sidebar is a scroll
/// bar, and the count it reports says how many were left out.
const FILE_ROW_CAP = 2000;

/// Every indexed file, with how many symbols came out of it.
///
/// Counting only files that produced symbols is how the tree came to list 45 of
/// this repository's 107 indexed files: three source files export nothing the
/// parser calls a symbol, and every documentation file is a `doc` node with no
/// symbols under it at all. A file missing from the tree reads as a file missing
/// from the index.
function fileEntries() {
  const counts = new Map();
  for (const node of nodes) {
    if (node.kind === "file" || node.kind === "doc") {
      if (!counts.has(node.file)) counts.set(node.file, 0);
      continue;
    }
    counts.set(node.file, (counts.get(node.file) || 0) + 1);
  }
  const ordered = [...counts.entries()].sort(
    (left, right) => right[1] - left[1] || (left[0] < right[0] ? -1 : 1)
  );
  return { entries: ordered.slice(0, FILE_ROW_CAP), total: ordered.length };
}

function buildTree() {
  const host = document.getElementById("tree");
  const { entries, total } = fileEntries();
  // Grouped by directory, not a flat list. A flat list of 1836 paths sorted by
  // symbol count is a search box with extra steps; the directory is how anyone
  // who works in the repository already thinks about it.
  const groups = new Map();
  for (const [file, count] of entries) {
    const cut = file.lastIndexOf("/");
    const directory = cut === -1 ? "." : file.slice(0, cut);
    const leaf = cut === -1 ? file : file.slice(cut + 1);
    if (!groups.has(directory)) groups.set(directory, { total: 0, files: [] });
    const group = groups.get(directory);
    group.total += count;
    group.files.push([file, leaf, count]);
  }
  const ordered = [...groups.entries()].sort(
    (left, right) => right[1].total - left[1].total || left[0].localeCompare(right[0])
  );
  const shown =
    entries.length < total
      ? `${entries.length} of ${total} files`
      : `${total} file${total === 1 ? "" : "s"}`;
  host.innerHTML =
    `<p class="cc-note">${shown} in ${ordered.length} director${ordered.length === 1 ? "y" : "ies"}` +
    `<button class="treetog" data-all="collapse">collapse all</button></p>` +
    ordered
      .map(([directory, group]) => {
        const open = ordered.length <= 12 || group.total >= entries.length / 2;
        return (
          `<div class="tgroup${open ? " open" : ""}" data-dir="${escapeHtml(directory)}">` +
          `<div class="tdir" tabindex="0" role="button"><span class="caret">&#9656;</span>` +
          `<span class="name">${escapeHtml(directory)}</span><span class="n">${group.total}</span></div>` +
          `<div class="tfiles">` +
          group.files
            .map(
              ([file, leaf, count]) =>
                `<div class="leaf" data-file="${escapeHtml(file)}" tabindex="0" role="button" title="${escapeHtml(file)}">` +
                `<span class="name">${escapeHtml(leaf)}</span><span class="n">${count || ""}</span></div>`
            )
            .join("") +
          `</div></div>`
        );
      })
      .join("");
  for (const directory of host.querySelectorAll(".tdir")) {
    const toggle = () => directory.parentElement.classList.toggle("open");
    directory.addEventListener("click", toggle);
    directory.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        toggle();
      }
    });
  }
  const all = host.querySelector(".treetog");
  if (all) {
    all.addEventListener("click", () => {
      const collapsing = all.dataset.all === "collapse";
      for (const group of host.querySelectorAll(".tgroup")) group.classList.toggle("open", !collapsing);
      all.dataset.all = collapsing ? "expand" : "collapse";
      all.textContent = collapsing ? "expand all" : "collapse all";
    });
  }
  for (const leaf of host.querySelectorAll(".leaf")) {
    const go = () => setState({ mode: State.mode === "overview" ? "explore" : State.mode, focus: leaf.dataset.file }, { push: true });
    leaf.addEventListener("click", go);
    leaf.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        go();
      }
    });
  }
}

function markTreeActive() {
  const target = resolveFocus(State.focus);
  for (const leaf of document.querySelectorAll("#tree .leaf")) {
    const active = !!target && leaf.dataset.file === target.file;
    leaf.classList.toggle("active", active);
    // A highlighted file inside a collapsed directory is a highlight nobody
    // sees.
    if (active) leaf.closest(".tgroup")?.classList.add("open");
  }
}

function checkboxGroup(hostId, title, values, allowed, counts, onChange) {
  const host = document.getElementById(hostId);
  host.innerHTML =
    `<h4>${title}</h4>` +
    values
      .map(
        (value) =>
          `<label class="frow"><input type="checkbox" ${!allowed || allowed.has(value) ? "checked" : ""} data-value="${escapeHtml(value)}">` +
          `${escapeHtml(String(value).toLowerCase())}<span class="n">${counts.get(value) || 0}</span></label>`
      )
      .join("");
  for (const box of host.querySelectorAll("input")) {
    box.addEventListener("change", () => {
      const picked = [...host.querySelectorAll("input")].filter((input) => input.checked).map((input) => input.dataset.value);
      onChange(picked.length === values.length ? null : new Set(picked));
    });
  }
}

function buildFilters() {
  const kindCounts = new Map();
  for (const node of nodes) kindCounts.set(node.kind, (kindCounts.get(node.kind) || 0) + 1);
  const relCounts = new Map();
  const confCounts = new Map();
  for (const edge of links) {
    relCounts.set(edge.kind, (relCounts.get(edge.kind) || 0) + 1);
    confCounts.set(edge.confidence, (confCounts.get(edge.confidence) || 0) + 1);
  }
  checkboxGroup("f-kinds", "Node kinds", ALL_KIND, State.kind, kindCounts, (kind) => setState({ kind }));
  checkboxGroup("f-rels", "Relation kinds", ALL_REL, State.rel, relCounts, (rel) => setState({ rel }));
  checkboxGroup("f-conf", "Edge confidence", ALL_CONF, State.conf, confCounts, (conf) => setState({ conf }));
}

function selectTab(which) {
  for (const name of ["explorer", "filters"]) {
    document.getElementById(`tab-${name}`).classList.toggle("on", name === which);
    document.getElementById(`tab-btn-${name}`).classList.toggle("active", name === which);
    document.getElementById(`tab-btn-${name}`).setAttribute("aria-selected", String(name === which));
  }
}

// --- Command palette ---------------------------------------------------------
const COMMANDS = [
  ...MODE_LIST.map((mode) => ({ label: `Mode: ${mode.label}`, run: () => enterMode(mode.id) })),
  { label: "Reset filters", run: () => setState({ rel: null, conf: null, kind: null, community: null }) },
  { label: "Clear pins", run: () => setState({ pins: new Set() }) },
  { label: "Collapse all modules", run: () => setState({ expanded: new Set() }) },
  { label: "Fit view", run: () => setState({ cam: null }) },
  {
    label: "Copy shareable link",
    run: () => navigator.clipboard && navigator.clipboard.writeText(location.href).then(() => notice("Link copied.")),
  },
];

let paletteIndex = 0;
let paletteItems = [];

function togglePalette(force) {
  const host = document.getElementById("palette");
  const open = force === undefined ? host.hidden : force;
  host.hidden = !open;
  if (open) {
    const input = document.getElementById("palette-input");
    input.value = "";
    renderPalette("");
    input.focus();
  }
}

function renderPalette(query) {
  const lowered = query.toLowerCase().trim();
  const matches = (text) => !lowered || text.toLowerCase().includes(lowered);
  paletteItems = [
    ...COMMANDS.filter((command) => matches(command.label)).map((command) => ({ label: command.label, hint: "command", run: command.run })),
    ...(lowered
      ? nodes
          .filter((node) => matches(node.name) || matches(node.file))
          .slice(0, 30)
          .map((node) => ({
            label: nodeLabel(node),
            hint: node.file,
            run: () => setState({ mode: State.mode === "overview" ? "explore" : State.mode, focus: String(node.id) }, { push: true }),
          }))
      : []),
  ].slice(0, 40);
  paletteIndex = 0;
  const list = document.getElementById("palette-list");
  list.innerHTML = paletteItems
    .map(
      (item, index) =>
        `<div class="prow${index === 0 ? " on" : ""}" data-i="${index}"><span class="name">${escapeHtml(item.label)}</span><span class="hint">${escapeHtml(item.hint)}</span></div>`
    )
    .join("");
  for (const row of list.querySelectorAll(".prow")) {
    row.addEventListener("click", () => runPalette(Number(row.dataset.i)));
  }
}

function movePalette(delta) {
  if (!paletteItems.length) return;
  paletteIndex = (paletteIndex + delta + paletteItems.length) % paletteItems.length;
  const list = document.getElementById("palette-list");
  for (const row of list.querySelectorAll(".prow")) {
    row.classList.toggle("on", Number(row.dataset.i) === paletteIndex);
  }
  const active = list.querySelector(".prow.on");
  if (active) active.scrollIntoView({ block: "nearest" });
}

function runPalette(index) {
  const item = paletteItems[index];
  togglePalette(false);
  if (item) item.run();
}

// --- Keyboard ----------------------------------------------------------------
// Every core task is reachable without a pointer.
function walkNeighbour(delta) {
  const current = selected || resolveFocus(State.focus);
  if (!current) return;
  const ranked = [
    ...(outgoing.get(current.id) || []).filter(edgeAllowed).map((edge) => byId.get(edge.target)),
    ...(incoming.get(current.id) || []).filter(edgeAllowed).map((edge) => byId.get(edge.source)),
  ].filter(Boolean);
  if (!ranked.length) return;
  const position = ranked.findIndex((node) => selected && node.id === selected.id);
  const next = ranked[(position + delta + ranked.length) % ranked.length];
  selected = next;
  if (scene.hasNode(`n${next.id}`)) {
    inspectNode(next, scene.getNodeAttributes(`n${next.id}`));
    renderer.refresh();
  } else {
    setState({ focus: String(next.id) }, { push: true });
  }
}

document.addEventListener("keydown", (event) => {
  const palette = document.getElementById("palette");
  if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
    event.preventDefault();
    togglePalette();
    return;
  }
  if (!palette.hidden) {
    if (event.key === "Escape") togglePalette(false);
    if (event.key === "ArrowDown") {
      event.preventDefault();
      movePalette(1);
    }
    if (event.key === "ArrowUp") {
      event.preventDefault();
      movePalette(-1);
    }
    if (event.key === "Enter") {
      event.preventDefault();
      runPalette(paletteIndex);
    }
    return;
  }
  if (event.target.matches("input, textarea")) return;
  if (event.key === "/") {
    event.preventDefault();
    document.getElementById("search").focus();
    return;
  }
  const index = Number(event.key);
  if (Number.isInteger(index) && index >= 1 && index <= MODE_IDS.length) {
    enterMode(MODE_IDS[index - 1]);
    return;
  }
  if (event.key === "ArrowRight") walkNeighbour(1);
  if (event.key === "ArrowLeft") walkNeighbour(-1);
  if (event.key === "Escape") {
    if (State.mode !== "overview") enterMode("overview");
    else {
      selected = null;
      document.getElementById("panel").classList.remove("open");
      if (renderer) renderer.refresh();
    }
  }
});

// --- Bootstrap ----------------------------------------------------------------
{
  // Documentation is indexed too, and the pill disagreeing with the file tree
  // beside it is how a reader learns not to trust either number.
  const fileCount = new Set(nodes.filter((node) => node.kind === "file" || node.kind === "doc").map((node) => node.file)).size;
  const repoName = "__REPO_NAME__";
  document.getElementById("repo-pill").innerHTML = `<b>${escapeHtml(repoName)}</b> \u00b7 ${fileCount} files`;
  document.getElementById("c-nodes").textContent = nodes.length;
  document.getElementById("c-edges").textContent = links.length;
}

function visible(element) {
  return !!(element && element.offsetWidth && element.offsetHeight);
}
window.addEventListener("resize", () => {
  if (renderer && visible(document.getElementById("view"))) renderer.resize();
});

document.getElementById("tab-btn-explorer").addEventListener("click", () => selectTab("explorer"));
document.getElementById("tab-btn-filters").addEventListener("click", () => selectTab("filters"));
document.getElementById("palette-input").addEventListener("input", (event) => renderPalette(event.target.value));

readUrl();
buildModeSwitcher();
buildTree();
buildFilters();
selectTab("explorer");
applyState();
writeUrl(false);
</script>
