<script>/*__GRAPHOLOGY_JS__*/</script>
<script>/*__SIGMA_JS__*/</script>
<script type="module">
// A module, for one reason: the payloads below are gzipped when they are large,
// and inflating needs `await`. Module scope is safe here — sigma and
// graphology are loaded as classic scripts above and hang off `window`, and
// nothing outside this block reads what it declares.
const RAW_DATA = await hydrate(/*__GRAPH_DATA__*/);
const RAW_FILES = await hydrate(/*__FILES_DATA__*/);
const FILES = RAW_FILES.files || RAW_FILES;
const FILES_OMITTED = RAW_FILES.omitted || 0;
const DATA = decodePayload(RAW_DATA);

/// Unwraps a payload the exporter compressed.
///
/// A page for a large repository carries megabytes of graph, and it has to stay
/// one file that opens from `file://` — a browser will not fetch a sidecar next
/// to a local file, which is why everything is inlined. Gzip keeps the single
/// file and removes most of its weight; `DecompressionStream` is in every
/// current browser and needs no library. A payload that was small enough to
/// leave as plain JSON passes straight through.
async function hydrate(payload) {
  if (!payload || payload.format !== "gzip-base64-1") return payload;
  if (typeof DecompressionStream !== "function") {
    throw new Error(
      "this page stores its graph compressed and this browser has no DecompressionStream; " +
        "open it in a current browser, or read .aag/graph.json directly"
    );
  }
  const binary = atob(payload.data);
  const bytes = new Uint8Array(binary.length);
  for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index);
  const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("gzip"));
  return JSON.parse(await new Response(stream).text());
}

/// Expands the columnar page payload into the object shape the rest of this
/// page works with. The payload is columnar because an edge as four integers
/// in parallel arrays costs a quarter of what the same edge costs as an
/// object with four named keys, and the edge list dominates the page — see
/// `docs/graph-experience.md`. Anything else (an older page, a hand-edited
/// payload) passes through untouched.
function decodePayload(raw) {
  if (!raw || raw.format !== "columnar-1") return raw;
  const dict = raw.dict, n = raw.nodes, e = raw.edges;
  const nodes = n.id.map((id, i) => ({
    id,
    kind: dict.nodeKind[n.kind[i]],
    name: n.name[i],
    file: dict.file[n.file[i]],
    startLine: n.startLine[i],
    endLine: n.endLine[i],
    community: n.community[i],
    degree: n.degree[i],
  }));
  const edges = e.source.map((source, i) => ({
    source,
    target: e.target[i],
    kind: dict.edgeKind[e.kind[i]],
    confidence: dict.confidence[e.confidence[i]],
  }));
  return Object.assign({}, raw, { nodes, edges });
}

// Module (community) colors — muted, readable on the dark surface without
// reading as neon. Assigned by module size; wraps past 16.
const PALETTE = [
  "#5e8ef7", "#4db894", "#c9a24c", "#c96a75", "#9a82d9", "#4fa8c9", "#c9825e", "#7fb85e",
  "#b8629e", "#54b8ad", "#a8944c", "#8a7ed9", "#c96a94", "#94b85e", "#c9944c", "#6aa2d9",
];
const EDGE_COLOR = "#33332f";
/// The hover plate matches the panels rather than sigma's white default, and
/// is opaque so an edge running underneath cannot bleed through the name.
const HOVER_PLATE = "#1c1c1c";
const HOVER_PLATE_BORDER = "#3a3a36";
/// A node drawn smaller than this carries no readable shape, so the kind
/// outline is skipped rather than drawn around something invisible. The upper
/// bound matters more: sigma keeps its circles small as the camera dives in,
/// while `scaleSize` keeps growing, so an unclamped outline balloons past the
/// node it describes and neighbouring outlines overlap into a rosette that
/// reads as a rendering fault.
const MIN_SHAPE_RADIUS = 2.5;
const MAX_SHAPE_RADIUS = 16;
const EDGE_HL = "#ffc600";

const DEFAULT_SETTINGS = { repulsion: 8, gravity: 6, cluster: 8, nodeScale: 1, labelDensity: 4, edgeOpacity: 0.3, liveSim: false };
let settings = { ...DEFAULT_SETTINGS, ...JSON.parse(localStorage.getItem("aag-graph-settings") || "{}") };
function saveSettings() { localStorage.setItem("aag-graph-settings", JSON.stringify(settings)); }

// Deterministic PRNG (mulberry32, fixed seed) — the layout must come out the
// same every time the page opens, or the graph "moves" between visits.
function mulberry32(seed) {
  return () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const nodes = DATA.nodes;
const byId = new Map(nodes.map((n) => [n.id, n]));
const links = DATA.edges.map((e) => ({ ...e, s: byId.get(e.source), t: byId.get(e.target) })).filter((e) => e.s && e.t);

const degree = new Map();
for (const e of links) {
  degree.set(e.source, (degree.get(e.source) || 0) + 1);
  degree.set(e.target, (degree.get(e.target) || 0) + 1);
}
for (const n of nodes) {
  n.degree = degree.get(n.id) || 0;
  n.mass = n.degree + 1;
}

// --- Communities: taken from the payload, not recomputed -------------------
// The exporter already detected communities, folded strays into the dominant
// community of their own file, renumbered so id 0 is the largest, and shipped
// a label plus cohesion/entrypoint/confidence facts per community (see
// `docs/graph-experience.md`). The page used to redo all of that with its own
// label propagation, which meant this page coloured by one numbering while the
// payload's aggregates and bundles used another. One source of truth.
const COMMUNITIES = DATA.communities || [];
const BUNDLES = DATA.bundles || [];
const ENTRYPOINTS = new Set(DATA.entrypoints || []);
const communityCount = COMMUNITIES.length;
// A symbol nothing connects to belongs to no community. Give them all one
// shared neutral bucket instead of letting `null` reach every lookup that
// indexes by community id.
const UNGROUPED = communityCount;
for (const n of nodes) if (n.community === null || n.community === undefined) n.community = UNGROUPED;
const communityColor = (c) => (c === UNGROUPED ? "#3a3a36" : PALETTE[c % PALETTE.length]);
const communityById = new Map(COMMUNITIES.map((c) => [c.id, c]));

// Human-readable module names: the exporter's label (the deepest directory
// every member shares) plus the highest-degree member, e.g.
// "src/ · resolve_calls".
const communityMeta = COMMUNITIES.map((community) => {
  const top = community.representatives
    .map((id) => byId.get(id))
    .filter(Boolean)
    .sort((a, b) => b.degree - a.degree || a.id - b.id)[0];
  return {
    id: community.id,
    size: community.members.length,
    name: top ? `${community.label || "./"} · ${top.name}` : community.label || `#${community.id}`,
    label: community.label || `#${community.id}`,
    internalEdges: community.internalEdges,
    externalEdges: community.externalEdges,
    entrypoints: community.entrypoints,
    worstConfidence: community.worstConfidence,
    representatives: community.representatives,
  };
});
communityMeta.push({
  id: UNGROUPED,
  size: nodes.filter((n) => n.community === UNGROUPED).length,
  name: "unconnected",
  label: "unconnected",
  internalEdges: 0,
  externalEdges: 0,
  entrypoints: 0,
  worstConfidence: "EXTRACTED",
  representatives: [],
});

// --- Visual grammar ----------------------------------------------------------
// One channel per dimension, and nothing carried by colour alone — see
// `docs/graph-experience.md`. Sigma's default programs draw circles and plain
// lines, so node kind is carried by a label glyph rather than a shape, and
// relation kind by hue plus width. Dashes and shapes would need custom WebGL
// programs; the glyph keeps the distinction available today without one.
const KIND_GLYPH = {
  file: "▢",
  doc: "◇",
  function: "●",
  method: "○",
  struct: "■",
  interface: "△",
  endpoint: "⬡",
  schema: "▤",
  database_table: "▥",
  infra_resource: "▲",
};
const REL_STYLE = {
  calls: { color: "#6f6f66", width: 1 },
  imports: { color: "#4d6b7a", width: 1 },
  inherits: { color: "#7d5f92", width: 1.6 },
  implements: { color: "#5f8060", width: 1.6 },
  explains: { color: "#7d6a4a", width: 0.8 },
  references: { color: "#4a4a44", width: 0.8 },
};
const CONF_WEIGHT = { EXTRACTED: 1, INFERRED: 0.72, AMBIGUOUS: 0.42 };
const SURFACE = [10, 10, 10];

// Blends a colour toward the page background. Sigma's edge program takes no
// per-edge alpha, so confidence has to be baked into the colour itself.
function fade(hex, weight) {
  const value = parseInt(hex.slice(1), 16);
  const parts = [(value >> 16) & 255, (value >> 8) & 255, value & 255];
  const mixed = parts.map((channel, index) =>
    Math.round(SURFACE[index] + (channel - SURFACE[index]) * weight)
  );
  return `#${mixed.map((c) => c.toString(16).padStart(2, "0")).join("")}`;
}

function edgeStyle(edge) {
  const style = REL_STYLE[edge.kind] || REL_STYLE.calls;
  const weight = CONF_WEIGHT[edge.confidence] ?? 0.5;
  return { color: fade(style.color, weight), size: style.width * (0.6 + weight * 0.7) };
}

function nodeLabel(node) {
  return `${KIND_GLYPH[node.kind] || "●"} ${node.name}`;
}

/// Long enough to identify a symbol, short enough that the label does not
/// become a white bar across the scene: Sigma draws labels on an opaque plate,
/// and a test function name runs past 70 characters. Only the canvas
/// truncates — the panel and the search results have room for the real name.
const MAX_SCENE_LABEL_CHARS = 34;

function sceneLabel(node) {
  const name = node.name || "";
  const short =
    name.length > MAX_SCENE_LABEL_CHARS ? `${name.slice(0, MAX_SCENE_LABEL_CHARS - 1)}\u2026` : name;
  return `${KIND_GLYPH[node.kind] || "●"} ${short}`;
}

/// Hover label: a dark plate with the page's border and text colours, so the
/// name stays readable instead of vanishing into sigma's white default.
function drawHoverLabel(context, data, settings) {
  if (typeof data.label !== "string" || !data.label) return;
  const size = settings.labelSize;
  const font = settings.labelFont;
  const weight = settings.labelWeight || "400";
  context.font = `${weight} ${size}px ${font}`;
  const width = context.measureText(data.label).width;
  const padX = 7;
  const padY = 4;
  const boxHeight = size + padY * 2;
  const left = data.x + data.size + 3;
  const top = data.y - boxHeight / 2;
  const radius = 5;

  context.save();
  context.shadowOffsetX = 0;
  context.shadowOffsetY = 1;
  context.shadowBlur = 8;
  context.shadowColor = "rgba(0, 0, 0, 0.6)";
  context.beginPath();
  context.moveTo(left + radius, top);
  context.lineTo(left + width + padX * 2 - radius, top);
  context.quadraticCurveTo(left + width + padX * 2, top, left + width + padX * 2, top + radius);
  context.lineTo(left + width + padX * 2, top + boxHeight - radius);
  context.quadraticCurveTo(
    left + width + padX * 2,
    top + boxHeight,
    left + width + padX * 2 - radius,
    top + boxHeight
  );
  context.lineTo(left + radius, top + boxHeight);
  context.quadraticCurveTo(left, top + boxHeight, left, top + boxHeight - radius);
  context.lineTo(left, top + radius);
  context.quadraticCurveTo(left, top, left + radius, top);
  context.closePath();
  context.fillStyle = HOVER_PLATE;
  context.fill();
  context.shadowColor = "transparent";
  context.lineWidth = 1;
  context.strokeStyle = HOVER_PLATE_BORDER;
  context.stroke();

  context.fillStyle = settings.labelColor.color || "#f2f2ee";
  context.textBaseline = "middle";
  context.fillText(data.label, left + padX, data.y + 0.5);
  context.restore();
}

function nodeSize(node) {
  return (3 + Math.min(Math.sqrt(node.degree || 0) * 1.7, 13)) * settings.nodeScale;
}

// --- Adjacency ---------------------------------------------------------------
// Built once. Every mode walks these instead of scanning the edge list.
const outgoing = new Map();
const incoming = new Map();
for (const edge of links) {
  if (!outgoing.has(edge.source)) outgoing.set(edge.source, []);
  if (!incoming.has(edge.target)) incoming.set(edge.target, []);
  outgoing.get(edge.source).push(edge);
  incoming.get(edge.target).push(edge);
}
const neighborsOf = new Map();
for (const edge of links) {
  if (!neighborsOf.has(edge.source)) neighborsOf.set(edge.source, new Set());
  if (!neighborsOf.has(edge.target)) neighborsOf.set(edge.target, new Set());
  neighborsOf.get(edge.source).add(edge.target);
  neighborsOf.get(edge.target).add(edge.source);
}

function edgeAllowed(edge) {
  return !hiddenRel.has(edge.kind) && !hiddenConf.has(edge.confidence);
}
function nodeAllowed(node) {
  if (hiddenKinds.has(node.kind)) return false;
  if (State.community !== null && node.community !== State.community) return false;
  return true;
}

const isTestPath = (file) => /(^|\/)(tests?|spec|__tests__)\//i.test(file) || /[._-](test|spec)\./i.test(file);

// How much a neighbour is worth showing: an explicit relation beats a guessed
// one, a contract or entrypoint beats a leaf, and a hub beats a singleton.
function neighborScore(node, edge) {
  let score = CONF_WEIGHT[edge.confidence] ?? 0.5;
  score *= edge.kind === "explains" ? 0.5 : 1;
  if (ENTRYPOINTS.has(node.id)) score += 0.6;
  if (node.kind === "endpoint" || node.kind === "schema") score += 0.5;
  if (isTestPath(node.file)) score -= 0.2;
  return score + Math.min(Math.log1p(node.degree || 0) * 0.25, 1);
}

// --- Scene engine ------------------------------------------------------------
// Every mode produces the same shape — nodes, edges, a layout kind — and one
// renderer draws it. The whole-repository force layout is gone: no mode needs
// every symbol on screen at once, and the budgets in
// `docs/graph-experience.md` say it must not try.
const MAX_SCENE_NODES = 420;
/// Past this many nodes, "expand all" is warned about before it runs: the
/// scene budget above is what keeps the page responsive, and opening every
/// module deliberately spends it.
const WHOLE_GRAPH_WARN = 5000;

let scene = null;
let renderer = null;
let sceneSpec = null;
let selected = null;
let hoveredNode = null;
let sceneOmitted = 0;

const IMPACT_GLYPH = { changed: "◆", direct: "◐", transitive: "○" };

function nodeEntry(node, extra) {
  const base = {
    key: `n${node.id}`,
    label: sceneLabel(node),
    size: nodeSize(node),
    color: communityColor(node.community),
    _node: node,
  };
  const merged = Object.assign(base, extra || {});
  // Impact state is a second dimension on the same node, so it gets its own
  // channel — a glyph and a size step, never a hue the module already owns.
  if (merged._impact) {
    merged.label = `${IMPACT_GLYPH[merged._impact] || ""} ${merged.label}`;
    if (merged._impact === "transitive") {
      merged.size = Math.max(3, merged.size * 0.75);
      merged.color = fade(merged.color, 0.6);
    }
    if (merged._test) merged.label = `${merged.label} · test`;
  }
  return merged;
}

// --- Overview ----------------------------------------------------------------
function overviewSpec() {
  const items = [];
  const edges = [];
  const shown = COMMUNITIES.filter((c) => State.community === null || c.id === State.community);
  const anchorOf = new Map();

  for (const community of shown) {
    const meta = communityMeta[community.id] || {};
    if (State.expanded.has(community.id)) {
      for (const id of community.members) {
        const node = byId.get(id);
        if (node && nodeAllowed(node)) items.push(nodeEntry(node));
      }
      anchorOf.set(community.id, community.representatives.length ? `n${community.representatives[0]}` : null);
    } else {
      items.push({
        key: `c${community.id}`,
        label: `${meta.label || "#" + community.id} (${community.members.length})`,
        size: 6 + Math.min(Math.sqrt(community.members.length) * 3.2, 26),
        color: communityColor(community.id),
        _aggregate: community,
      });
      anchorOf.set(community.id, `c${community.id}`);
    }
  }
  const present = new Set(items.map((item) => item.key));

  if (State.expanded.size) {
    let index = 0;
    for (const edge of links) {
      if (edge.s.community !== edge.t.community) continue;
      if (!State.expanded.has(edge.s.community) || !edgeAllowed(edge)) continue;
      if (!present.has(`n${edge.source}`) || !present.has(`n${edge.target}`)) continue;
      edges.push(Object.assign({ key: `i${index++}`, from: `n${edge.source}`, to: `n${edge.target}`, _edge: edge }, edgeStyle(edge)));
    }
  }

  let index = 0;
  for (const bundle of BUNDLES) {
    if (hiddenRel.has(bundle.kind)) continue;
    const from = anchorOf.get(bundle.a);
    const to = anchorOf.get(bundle.b);
    if (!from || !to || !present.has(from) || !present.has(to) || from === to) continue;
    edges.push({
      key: `b${index++}`,
      from,
      to,
      size: Math.min(0.6 + Math.log1p(bundle.count) * 0.9, 6),
      color: fade(
        (REL_STYLE[bundle.kind] || REL_STYLE.calls).color,
        bundle.ambiguous > bundle.extracted + bundle.inferred ? 0.45 : 0.9
      ),
      _bundle: bundle,
    });
  }
  return { layout: "force", items, edges, omitted: 0, caption: `${shown.length} modules` };
}

// --- Explore -----------------------------------------------------------------
// A ranked neighbourhood around one symbol, with upstream and downstream depth
// controlled separately, and a hard cap that reports what it dropped.
function exploreSpec() {
  const root = resolveFocus(State.focus);
  if (!root) return { layout: "force", items: [], edges: [], omitted: 0, empty: "Pick a symbol to explore." };

  const depth = new Map([[root.id, 0]]);
  const direction = new Map([[root.id, "root"]]);
  const kept = new Set([root.id]);
  // Where neighbours are really lost: a hub with 900 neighbours shows the top
  // few per hop. Whatever the ranking cuts is remembered, not forgotten.
  const overflowed = new Set();
  let frontier = [root.id];
  for (let hop = 1; hop <= Math.max(State.down, 0) && frontier.length; hop++) {
    const next = [];
    for (const id of frontier) {
      const scored = (outgoing.get(id) || [])
        .filter(edgeAllowed)
        .map((edge) => ({ edge, node: byId.get(edge.target) }))
        .filter((candidate) => candidate.node && nodeAllowed(candidate.node) && !kept.has(candidate.node.id))
        .sort((left, right) => neighborScore(right.node, right.edge) - neighborScore(left.node, left.edge));
      const budget = hop === 1 ? 40 : 12;
      const ranked = scored.filter(
        (candidate, position) => position < budget || State.expanded.has(candidate.node.community)
      );
      for (const candidate of scored.slice(budget)) {
        if (!State.expanded.has(candidate.node.community)) overflowed.add(candidate.node.id);
      }
      for (const candidate of ranked) {
        kept.add(candidate.node.id);
        depth.set(candidate.node.id, hop);
        direction.set(candidate.node.id, "down");
        next.push(candidate.node.id);
      }
    }
    frontier = next;
  }
  frontier = [root.id];
  for (let hop = 1; hop <= Math.max(State.up, 0) && frontier.length; hop++) {
    const next = [];
    for (const id of frontier) {
      const scored = (incoming.get(id) || [])
        .filter(edgeAllowed)
        .map((edge) => ({ edge, node: byId.get(edge.source) }))
        .filter((candidate) => candidate.node && nodeAllowed(candidate.node) && !kept.has(candidate.node.id))
        .sort((left, right) => neighborScore(right.node, right.edge) - neighborScore(left.node, left.edge));
      const budget = hop === 1 ? 40 : 12;
      const ranked = scored.filter(
        (candidate, position) => position < budget || State.expanded.has(candidate.node.community)
      );
      for (const candidate of scored.slice(budget)) {
        if (!State.expanded.has(candidate.node.community)) overflowed.add(candidate.node.id);
      }
      for (const candidate of ranked) {
        kept.add(candidate.node.id);
        depth.set(candidate.node.id, hop);
        direction.set(candidate.node.id, "up");
        next.push(candidate.node.id);
      }
    }
    frontier = next;
  }
  for (const id of State.pins) if (byId.has(id)) kept.add(id);

  let omitted = 0;
  let ids = [...kept];
  let dropped = [];
  if (ids.length > MAX_SCENE_NODES) {
    const ranked = ids.sort(
      (left, right) =>
        (depth.get(left) || 0) - (depth.get(right) || 0) ||
        (byId.get(right).degree || 0) - (byId.get(left).degree || 0)
    );
    // A capped neighbour is not a dropped neighbour: keep the overflow as
    // expandable aggregates so the scene never hides work without saying where
    // it went.
    dropped = ranked.slice(MAX_SCENE_NODES).filter((id) => !State.expanded.has(byId.get(id).community));
    const rescued = ranked.slice(MAX_SCENE_NODES).filter((id) => State.expanded.has(byId.get(id).community));
    omitted = dropped.length;
    ids = ranked.slice(0, MAX_SCENE_NODES).concat(rescued);
  }
  for (const id of overflowed) if (!kept.has(id)) dropped.push(id);
  omitted = dropped.length;
  const set = new Set(ids);
  const items = ids.map((id) => {
    const node = byId.get(id);
    return nodeEntry(node, {
      size: id === root.id ? nodeSize(node) * 1.9 + 3 : nodeSize(node),
      _depth: depth.get(id) || 0,
      _direction: direction.get(id),
      _pinned: State.pins.has(id),
    });
  });
  const edges = [];
  let index = 0;
  for (const edge of links) {
    if (!set.has(edge.source) || !set.has(edge.target) || !edgeAllowed(edge)) continue;
    edges.push(Object.assign({ key: `e${index++}`, from: `n${edge.source}`, to: `n${edge.target}`, _edge: edge }, edgeStyle(edge)));
  }

  // One aggregate per module the cap cut into, attached where its members
  // hung. Clicking it expands that module in place.
  const byCommunity = new Map();
  for (const id of dropped) {
    const community = byId.get(id).community;
    if (!byCommunity.has(community)) byCommunity.set(community, []);
    byCommunity.get(community).push(id);
  }
  for (const [community, members] of byCommunity) {
    const key = `m${community}`;
    const meta = communityMeta[community] || {};
    items.push({
      key,
      label: `+${members.length} more in ${meta.label || "#" + community}`,
      size: 5 + Math.min(Math.sqrt(members.length) * 2.6, 16),
      color: fade(communityColor(community), 0.55),
      _overflow: { community, members },
    });
    // Attach to whichever shown node the overflow actually connects to.
    const anchor = members
      .flatMap((id) => [...(neighborsOf.get(id) || [])])
      .find((other) => set.has(other));
    if (anchor !== undefined) {
      edges.push({
        key: `o${index++}`,
        from: key,
        to: `n${anchor}`,
        size: 1,
        color: fade(EDGE_COLOR, 0.7),
        _overflowEdge: true,
      });
    }
  }

  return {
    layout: "force",
    items,
    edges,
    omitted,
    root,
    caption: `${items.length} nodes · up ${State.up} / down ${State.down}`,
  };
}

// --- Path --------------------------------------------------------------------
// Directed shortest paths, drawn as layers rather than as a force graph: a
// path has an order, and a force layout hides it.
// Every shortest route, not just the first one found. BFS keeps *all*
// predecessors that discovered a node at its own depth, then the paths are
// enumerated from them — two equally short routes are two different answers,
// and showing one silently is showing half the truth.
function shortestPaths(fromId, toId, limit) {
  const depth = new Map([[fromId, 0]]);
  const arrivals = new Map();
  let frontier = [fromId];
  let reached = false;
  while (frontier.length && !reached) {
    const next = [];
    for (const id of frontier) {
      for (const edge of outgoing.get(id) || []) {
        if (!edgeAllowed(edge)) continue;
        const node = byId.get(edge.target);
        if (!node || !nodeAllowed(node)) continue;
        const hop = depth.get(id) + 1;
        const known = depth.get(edge.target);
        if (known !== undefined && known < hop) continue;
        if (known === undefined) {
          depth.set(edge.target, hop);
          next.push(edge.target);
        }
        if (!arrivals.has(edge.target)) arrivals.set(edge.target, []);
        arrivals.get(edge.target).push(edge);
        if (edge.target === toId) reached = true;
      }
    }
    frontier = next;
  }
  if (!arrivals.has(toId)) return [];

  const routes = [];
  const walk = (id, chain, seen) => {
    if (routes.length >= (limit || 4)) return;
    if (id === fromId) {
      routes.push(chain.slice());
      return;
    }
    for (const edge of arrivals.get(id) || []) {
      if (depth.get(edge.source) !== depth.get(id) - 1 || seen.has(edge.source)) continue;
      seen.add(edge.source);
      chain.unshift(edge);
      walk(edge.source, chain, seen);
      chain.shift();
      seen.delete(edge.source);
    }
  };
  walk(toId, [], new Set([toId]));
  return routes;
}

function pathSpec() {
  const from = resolveFocus(State.from);
  const to = resolveFocus(State.to);
  if (!from || !to) {
    return {
      layout: "layered",
      items: [],
      edges: [],
      omitted: 0,
      empty: from || to ? "Pick the other endpoint to trace a path." : "Pick a source and a target.",
    };
  }
  if (from.id === to.id) {
    return { layout: "layered", items: [], edges: [], omitted: 0, empty: "Source and target are the same node." };
  }
  const routes = shortestPaths(from.id, to.id);
  if (!routes.length) {
    return {
      layout: "layered",
      items: [],
      edges: [],
      omitted: 0,
      empty: `No directed path from ${from.name} to ${to.name} under the current filters.`,
    };
  }
  const layerOf = new Map([[from.id, 0]]);
  const items = [];
  const edges = [];
  const seen = new Set();
  const add = (id, layer) => {
    layerOf.set(id, Math.max(layerOf.get(id) ?? 0, layer));
    if (seen.has(id)) return;
    seen.add(id);
    const node = byId.get(id);
    const endpoint = id === from.id || id === to.id;
    items.push(nodeEntry(node, { _layer: layer, size: nodeSize(node) * (endpoint ? 1.7 : 1.2) + 2 }));
  };
  add(from.id, 0);
  routes.forEach((chain, route) => {
    chain.forEach((edge, hop) => {
      add(edge.target, hop + 1);
      const key = `p${route}_${hop}`;
      edges.push(
        Object.assign({ key, from: `n${edge.source}`, to: `n${edge.target}`, _edge: edge, _hop: hop + 1, _route: route }, edgeStyle(edge), {
          // The first route is the one to read; the alternatives are thinner
          // so a reader can tell them apart without a legend.
          size: route === 0 ? Math.max(2.4, edgeStyle(edge).size * 2) : 1.2,
        })
      );
    });
  });
  for (const item of items) item._layer = layerOf.get(item._node.id) ?? item._layer;
  return {
    layout: "layered",
    items,
    edges,
    omitted: 0,
    caption:
      routes.length > 1
        ? `${routes[0].length} hops · ${routes.length} equally short routes`
        : `${routes[0].length} hops`,
    routes,
  };
}

// --- Impact ------------------------------------------------------------------
// Dependents and dependencies separated, grouped by depth, with the things a
// reader must act on — tests, entrypoints, contracts — ranked first.
function impactSpec() {
  const root = resolveFocus(State.focus);
  if (!root) return { layout: "radial", items: [], edges: [], omitted: 0, empty: "Pick a symbol to see its blast radius." };

  function walk(adjacency, pick, maxDepth) {
    const seen = new Map();
    let frontier = [root.id];
    for (let hop = 1; hop <= maxDepth && frontier.length; hop++) {
      const next = [];
      for (const id of frontier) {
        for (const edge of adjacency.get(id) || []) {
          if (!edgeAllowed(edge)) continue;
          const other = pick(edge);
          const node = byId.get(other);
          if (!node || !nodeAllowed(node) || other === root.id || seen.has(other)) continue;
          seen.set(other, hop);
          next.push(other);
        }
      }
      frontier = next;
    }
    return seen;
  }
  const dependents = walk(incoming, (edge) => edge.source, Math.max(State.up, 1));
  const dependencies = walk(outgoing, (edge) => edge.target, Math.max(State.down, 1));

  const rank = (id) => {
    const node = byId.get(id);
    let score = 0;
    if (isTestPath(node.file)) score -= 3;
    if (ENTRYPOINTS.has(id)) score -= 2;
    if (node.kind === "endpoint" || node.kind === "schema") score -= 2;
    return score;
  };
  const collect = (map, side) =>
    [...map.entries()]
      .sort((left, right) => left[1] - right[1] || rank(left[0]) - rank(right[0]) || (byId.get(right[0]).degree || 0) - (byId.get(left[0]).degree || 0))
      .map(([id, depth]) => ({ id, depth, side }));

  const ordered = [...collect(dependents, "up"), ...collect(dependencies, "down")];
  const budget = MAX_SCENE_NODES - 1;
  const omitted = Math.max(0, ordered.length - budget);
  const chosen = ordered.slice(0, budget);
  const set = new Set([root.id, ...chosen.map((entry) => entry.id)]);

  const items = [
    nodeEntry(root, { _impact: "changed", _layer: 0, size: nodeSize(root) * 2 + 4 }),
    ...chosen.map((entry) =>
      nodeEntry(byId.get(entry.id), {
        _impact: entry.depth === 1 ? "direct" : "transitive",
        _side: entry.side,
        _layer: entry.side === "up" ? -entry.depth : entry.depth,
        _test: isTestPath(byId.get(entry.id).file),
      })
    ),
  ];
  const edges = [];
  let index = 0;
  for (const edge of links) {
    if (!set.has(edge.source) || !set.has(edge.target) || !edgeAllowed(edge)) continue;
    edges.push(Object.assign({ key: `x${index++}`, from: `n${edge.source}`, to: `n${edge.target}`, _edge: edge }, edgeStyle(edge)));
  }
  return {
    layout: "layered",
    items,
    edges,
    omitted,
    root,
    caption: `${dependents.size} dependents · ${dependencies.size} dependencies`,
    tests: [...set].filter((id) => id !== root.id && isTestPath(byId.get(id).file)).length,
  };
}

// --- Contracts ---------------------------------------------------------------
// Declared contract nodes beside the implementations that serve them, with the
// unmatched cases on both sides made visible rather than hidden.
const CONTRACT_KINDS = new Set(["endpoint", "schema", "database_table", "infra_resource"]);

function contractsSpec() {
  const contracts = nodes.filter((node) => CONTRACT_KINDS.has(node.kind) && nodeAllowed(node));
  if (!contracts.length) {
    return { layout: "force", items: [], edges: [], omitted: 0, empty: "This repository declares no contracts, endpoints, tables, or infrastructure resources." };
  }
  const items = [];
  const edges = [];
  const present = new Set();
  const add = (node, extra) => {
    if (present.has(node.id)) return;
    present.add(node.id);
    items.push(nodeEntry(node, extra));
  };
  let unmatched = 0;
  for (const contract of contracts) {
    const implementers = (incoming.get(contract.id) || [])
      .filter((edge) => edge.kind === "implements" && edgeAllowed(edge))
      .map((edge) => ({ edge, node: byId.get(edge.source) }))
      .filter((entry) => entry.node && nodeAllowed(entry.node));
    if (!implementers.length) unmatched++;
    add(contract, {
      _contract: true,
      _declared: contract.perspective === "declared",
      _matched: implementers.length > 0,
      size: nodeSize(contract) * 1.5 + 3,
    });
    for (const entry of implementers.slice(0, 6)) {
      add(entry.node, { _implements: contract.id });
      edges.push(
        Object.assign({ key: `c${edges.length}`, from: `n${entry.node.id}`, to: `n${contract.id}`, _edge: entry.edge }, edgeStyle(entry.edge), { size: 2 })
      );
    }
    for (const edge of (outgoing.get(contract.id) || []).filter((e) => e.kind === "references" && edgeAllowed(e))) {
      const referenced = byId.get(edge.target);
      if (!referenced || !nodeAllowed(referenced)) continue;
      add(referenced, { _schema: true });
      edges.push(Object.assign({ key: `c${edges.length}`, from: `n${contract.id}`, to: `n${referenced.id}`, _edge: edge }, edgeStyle(edge)));
    }
  }
  let omitted = 0;
  if (items.length > MAX_SCENE_NODES) {
    omitted = items.length - MAX_SCENE_NODES;
    items.length = MAX_SCENE_NODES;
  }
  const keys = new Set(items.map((item) => item.key));
  const declared = contracts.filter((contract) => contract.perspective === "declared").length;
  return {
    layout: "force",
    items,
    edges: edges.filter((edge) => keys.has(edge.from) && keys.has(edge.to)),
    omitted,
    caption: `${contracts.length} contracts · ${declared} declared · ${unmatched} without an implementation`,
  };
}

// --- Layout ------------------------------------------------------------------
// Two primitives: a force layout for neighbourhood-shaped scenes, and a
// layered one for scenes that have an order (a path, an impact fan-out).
// Both are deterministic, so a reload lands on the same picture.
function forceLayout(items, edges) {
  const positions = new Map();
  const radius = 110 + 20 * Math.sqrt(items.length);
  const index = new Map(items.map((item, position) => [item.key, position]));
  items.forEach((item, position) => {
    const angle = (2 * Math.PI * position) / items.length;
    positions.set(item.key, { x: Math.cos(angle) * radius, y: Math.sin(angle) * radius, dx: 0, dy: 0, r: item.size });
  });
  const rounds = items.length > 250 ? 140 : 240;
  const repulsion = 6000 + settings.repulsion * 900;
  const pull = 0.004 + settings.cluster * 0.0009;
  const gravity = 0.0008 + settings.gravity * 0.0002;
  for (let round = 0; round < rounds; round++) {
    const cooling = 1 - round / rounds;
    for (const point of positions.values()) {
      point.dx = 0;
      point.dy = 0;
    }
    for (let i = 0; i < items.length; i++) {
      const a = positions.get(items[i].key);
      for (let j = i + 1; j < items.length; j++) {
        const b = positions.get(items[j].key);
        let dx = a.x - b.x;
        let dy = a.y - b.y;
        let squared = dx * dx + dy * dy;
        if (squared < 1) {
          dx = i - j || 1;
          dy = 1;
          squared = 2;
        }
        const distance = Math.sqrt(squared);
        const force = (repulsion + 900 * (a.r + b.r)) / squared;
        a.dx += (dx / distance) * force;
        a.dy += (dy / distance) * force;
        b.dx -= (dx / distance) * force;
        b.dy -= (dy / distance) * force;
      }
    }
    for (const edge of edges) {
      const a = positions.get(edge.from);
      const b = positions.get(edge.to);
      if (!a || !b) continue;
      a.dx += (b.x - a.x) * pull;
      a.dy += (b.y - a.y) * pull;
      b.dx += (a.x - b.x) * pull;
      b.dy += (a.y - b.y) * pull;
    }
    for (const point of positions.values()) {
      point.x += Math.max(-30, Math.min(30, point.dx)) * cooling * 0.25 - point.x * gravity;
      point.y += Math.max(-30, Math.min(30, point.dy)) * cooling * 0.25 - point.y * gravity;
    }
  }
  separate(positions, items, 3.1);
  void index;
  return positions;
}

// Two nodes drawn on top of each other read as one node, which is a wrong
// answer rather than an ugly one.
function separate(positions, items, scale) {
  for (let round = 0; round < 40; round++) {
    let moved = 0;
    for (let i = 0; i < items.length; i++) {
      const a = positions.get(items[i].key);
      for (let j = i + 1; j < items.length; j++) {
        const b = positions.get(items[j].key);
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const distance = Math.sqrt(dx * dx + dy * dy) || 0.01;
        const wanted = (a.r + b.r) * scale;
        if (distance >= wanted) continue;
        const push = (wanted - distance) / 2;
        a.x -= (dx / distance) * push;
        a.y -= (dy / distance) * push;
        b.x += (dx / distance) * push;
        b.y += (dy / distance) * push;
        moved++;
      }
    }
    if (moved === 0) break;
  }
}

function layeredLayout(items) {
  const layers = new Map();
  for (const item of items) {
    const layer = item._layer ?? 0;
    if (!layers.has(layer)) layers.set(layer, []);
    layers.get(layer).push(item);
  }
  const ordered = [...layers.keys()].sort((a, b) => a - b);
  const positions = new Map();
  const columnGap = 260;
  ordered.forEach((layer, column) => {
    const column_items = layers.get(layer);
    const rowGap = Math.max(46, 520 / Math.max(column_items.length, 1));
    column_items.forEach((item, row) => {
      positions.set(item.key, {
        x: (column - (ordered.length - 1) / 2) * columnGap,
        y: (row - (column_items.length - 1) / 2) * rowGap,
        r: item.size,
      });
    });
  });
  separate(positions, items, 2.2);
  return positions;
}

// --- Layout cache ------------------------------------------------------------
// Keyed by what actually determines the picture. A changed node set
// invalidates rather than partially reusing: half-stale positions are worse
// than an honest relayout.
function layoutKey(spec) {
  const keys = spec.items.map((item) => item.key).sort().join(",");
  let hash = 2166136261;
  for (let i = 0; i < keys.length; i++) {
    hash ^= keys.charCodeAt(i);
    hash = Math.imul(hash, 16777619);
  }
  return `aag-layout:${spec.layout}:${spec.items.length}:${(hash >>> 0).toString(36)}:${settings.repulsion},${settings.gravity},${settings.cluster}`;
}

function cachedLayout(spec) {
  const key = layoutKey(spec);
  try {
    const stored = JSON.parse(localStorage.getItem(key) || "null");
    if (stored) return new Map(Object.entries(stored).map(([id, value]) => [id, { x: value[0], y: value[1], r: 6 }]));
  } catch (error) {
    void error;
  }
  const positions = spec.layout === "layered" ? layeredLayout(spec.items) : forceLayout(spec.items, spec.edges);
  try {
    const flat = {};
    for (const [id, point] of positions) flat[id] = [Math.round(point.x * 100) / 100, Math.round(point.y * 100) / 100];
    localStorage.setItem(key, JSON.stringify(flat));
  } catch (error) {
    void error; // a full quota is not a reason to fail a render
  }
  return positions;
}

// --- Rendering ---------------------------------------------------------------
const REDUCED_MOTION = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

function nodeReducer(key, data) {
  const result = { ...data };
  if (hoveredNode) {
    const near = neighborsOf.get(hoveredNode.id);
    const self = data._node && data._node.id === hoveredNode.id;
    if (!self && !(data._node && near && near.has(data._node.id))) {
      // Dim, never hide: a reader must still see the shape they are inside.
      result.color = fade(data.color, 0.28);
      result.label = null;
    }
  }
  if (searchQuery && data.label && !data.label.toLowerCase().includes(searchQuery)) {
    result.color = fade(data.color, 0.3);
  }
  if (selected && data._node && data._node.id === selected.id) {
    result.highlighted = true;
    result.size = data.size * 1.35 + 2;
  }
  if (data._pinned) result.type = "circle";
  return result;
}

function edgeReducer(key, data) {
  const result = { ...data };
  if (hoveredNode) {
    const incidentTo = data._edge && (data._edge.source === hoveredNode.id || data._edge.target === hoveredNode.id);
    if (incidentTo) {
      result.color = EDGE_HL;
      result.size = Math.max(data.size, 1.8);
    } else {
      // Fade rather than hide, so the surrounding structure stays legible.
      result.color = fade(data.color, 0.22);
    }
  }
  return result;
}

// Semantic zoom: which labels are worth drawing depends on how far out the
// camera is, not on a fixed threshold.
function labelFloorFor(ratio) {
  if (ratio > 0.6) return 22;
  if (ratio > 0.25) return 13;
  return 4;
}

function applySemanticZoom() {
  if (!renderer || !scene) return;
  const ratio = renderer.getCamera().getState().ratio;
  // Small scenes are never crowded, so the zoom band must not silently strip
  // their labels: a nine-node impact fan-out with no labels answers nothing.
  const floor = scene.order <= 60 ? 0 : labelFloorFor(ratio) * (0.6 + settings.labelDensity / 8);
  if (renderer.getSetting("labelRenderedSizeThreshold") !== floor) {
    renderer.setSetting("labelRenderedSizeThreshold", floor);
  }
}

function renderScene(spec) {
  sceneSpec = spec;
  sceneOmitted = spec.omitted || 0;
  scene = new graphology.Graph({ multi: true, type: "directed" });
  for (const item of spec.items) {
    if (scene.hasNode(item.key)) continue;
    scene.addNode(item.key, item);
  }
  for (const edge of spec.edges) {
    if (!scene.hasNode(edge.from) || !scene.hasNode(edge.to)) continue;
    scene.addEdgeWithKey(edge.key, edge.from, edge.to, edge);
  }
  const positions = spec.items.length ? cachedLayout(spec) : new Map();
  for (const key of scene.nodes()) {
    const point = positions.get(key) || { x: 0, y: 0 };
    scene.mergeNodeAttributes(key, { x: point.x, y: point.y });
  }

  if (renderer) {
    // Kill the old renderer before dropping the overlay: a frame that lands
    // between the two would draw the old scene onto the new canvas.
    renderer.removeAllListeners();
    renderer.kill();
  }
  discardOverlay();
  renderer = new Sigma(scene, document.getElementById("view"), {
    // A mode switch or a modal can hide this container; that is a normal
    // state here, not a misconfiguration.
    allowInvalidContainer: true,
    renderEdgeLabels: false,
    defaultEdgeColor: EDGE_COLOR,
    labelColor: { color: "#f2f2ee" },
    // Sigma's default hover renderer hardcodes a white plate and then paints
    // the label with `labelColor` on top of it, which on a dark page is white
    // on white. Ours uses the page's own surface colour.
    hoverRenderer: drawHoverLabel,
    labelSize: 11,
    labelFont: "ui-monospace, SFMono-Regular, Menlo, monospace",
    labelGridCellSize: spec.layout === "layered" ? 90 : 150,
    labelDensity: 0.7,
    labelRenderedSizeThreshold: 13,
    nodeReducer,
    edgeReducer,
    minCameraRatio: 0.03,
    maxCameraRatio: 14,
  });
  renderer.on("enterNode", ({ node }) => {
    hoveredNode = scene.getNodeAttribute(node, "_node") || null;
    renderer.refresh();
  });
  renderer.on("leaveNode", () => {
    hoveredNode = null;
    renderer.refresh();
  });
  renderer.on("clickNode", ({ node }) => {
    // A module bubble is a thing to open, so opening it is the click. The
    // panel still appears, so nothing is lost, but seeing what is inside no
    // longer costs a trip through a side panel button.
    const aggregate = scene.getNodeAttribute(node, "_aggregate");
    if (aggregate) {
      const expanded = new Set(State.expanded);
      expanded.has(aggregate.id) ? expanded.delete(aggregate.id) : expanded.add(aggregate.id);
      setState({ expanded });
      return;
    }
    inspect(node);
  });
  renderer.on("doubleClickNode", ({ node }) => {
    // Double-click reads the code. The status bar has promised this since the
    // first version of the page.
    const target = scene.getNodeAttribute(node, "_node");
    if (target && target.file) openFile(target.file, target.startLine, target.endLine);
  });
  renderer.on("clickStage", () => {
    selected = null;
    document.getElementById("panel").classList.remove("open");
    renderer.refresh();
  });
  renderer.getCamera().on("updated", () => {
    applySemanticZoom();
    scheduleCameraWrite();
  });
  renderer.on("afterRender", drawGrammar);
  fitScene();
  applySemanticZoom();
  renderSceneStatus(spec);
}

// --- Visual grammar overlay --------------------------------------------------
// Sigma's default programs draw circles and solid lines, so node kind and
// relation kind had nowhere to live except a label glyph and a hue. This layer
// draws the missing channels — an outline shape per node kind, a dash pattern
// per relation kind — on a 2D canvas pinned over the WebGL layers and redrawn
// after each sigma frame. A custom WebGL program would avoid the second pass;
// at the scene sizes these modes produce (hundreds of nodes, not thousands)
// the pass is cheaper than the shader work it would replace.
//
// Shapes are outlines around the node sigma already drew, not replacements, so
// a small radius error degrades to a slightly loose ring rather than a wrong
// picture.
const KIND_SHAPE = {
  file: "square",
  doc: "diamond",
  endpoint: "hexagon",
  schema: "square",
  database_table: "square",
  infra_resource: "triangle",
  struct: "diamond",
  interface: "triangle",
};
// `calls` is the common case and stays solid; everything else is
// distinguishable without reading a legend.
const REL_DASH = {
  imports: [5, 4],
  inherits: [9, 3],
  implements: [2, 3],
  explains: [1, 4],
  references: [1, 6],
};

let overlayCanvas = null;

function ensureOverlay() {
  if (overlayCanvas && overlayCanvas.isConnected) return overlayCanvas;
  overlayCanvas = document.createElement("canvas");
  overlayCanvas.id = "grammar-overlay";
  overlayCanvas.setAttribute("aria-hidden", "true");
  document.getElementById("view").append(overlayCanvas);
  return overlayCanvas;
}

/// Drops the overlay so the next scene starts on a blank one. A canvas that
/// outlives the renderer that drew it keeps painting whatever the last frame
/// left there: rings around nodes that have since moved or stopped existing,
/// which read as debris in the middle of the graph.
function discardOverlay() {
  if (overlayCanvas && overlayCanvas.isConnected) overlayCanvas.remove();
  overlayCanvas = null;
}

function drawShape(context, shape, x, y, radius) {
  context.beginPath();
  if (shape === "square") {
    context.rect(x - radius, y - radius, radius * 2, radius * 2);
  } else if (shape === "diamond") {
    context.moveTo(x, y - radius);
    context.lineTo(x + radius, y);
    context.lineTo(x, y + radius);
    context.lineTo(x - radius, y);
    context.closePath();
  } else if (shape === "triangle") {
    context.moveTo(x, y - radius);
    context.lineTo(x + radius, y + radius * 0.8);
    context.lineTo(x - radius, y + radius * 0.8);
    context.closePath();
  } else {
    for (let corner = 0; corner < 6; corner++) {
      const angle = (Math.PI / 3) * corner - Math.PI / 2;
      const point = [x + Math.cos(angle) * radius, y + Math.sin(angle) * radius];
      corner === 0 ? context.moveTo(point[0], point[1]) : context.lineTo(point[0], point[1]);
    }
    context.closePath();
  }
  context.stroke();
}

function drawGrammar() {
  if (!renderer || !scene) return;
  const host = document.getElementById("view");
  if (!host.offsetWidth || !host.offsetHeight) return;
  const canvas = ensureOverlay();
  const scale = window.devicePixelRatio || 1;
  if (canvas.width !== host.offsetWidth * scale || canvas.height !== host.offsetHeight * scale) {
    canvas.width = host.offsetWidth * scale;
    canvas.height = host.offsetHeight * scale;
    canvas.style.width = `${host.offsetWidth}px`;
    canvas.style.height = `${host.offsetHeight}px`;
  }
  const context = canvas.getContext("2d");
  // Clear the whole backing store in device pixels, with no transform in
  // effect. Clearing in CSS pixels under a scaled transform only covers the
  // canvas while the transform and the backing size agree; when they drift the
  // uncleared band keeps every ring drawn into it and the leftovers stack up
  // into a rosette.
  context.setTransform(1, 0, 0, 1, 0, 0);
  context.clearRect(0, 0, canvas.width, canvas.height);
  context.setTransform(scale, 0, 0, scale, 0, 0);

  context.lineWidth = 1;
  for (const key of scene.edges()) {
    const attributes = scene.getEdgeAttributes(key);
    const dash = REL_DASH[attributes._edge && attributes._edge.kind];
    if (!dash) continue;
    const reduced = edgeReducer(key, attributes);
    if (reduced.hidden) continue;
    const [from, to] = scene.extremities(key);
    const start = renderer.getNodeDisplayData(from);
    const end = renderer.getNodeDisplayData(to);
    if (!start || !end) continue;
    const a = renderer.graphToViewport(start);
    const b = renderer.graphToViewport(end);
    context.setLineDash(dash);
    context.strokeStyle = reduced.color || attributes.color;
    context.beginPath();
    context.moveTo(a.x, a.y);
    context.lineTo(b.x, b.y);
    context.stroke();
  }

  context.setLineDash([]);
  context.lineWidth = 1.4;
  for (const key of scene.nodes()) {
    const attributes = scene.getNodeAttributes(key);
    const kind = attributes._node && attributes._node.kind;
    const shape = KIND_SHAPE[kind];
    if (!shape) continue;
    const reduced = nodeReducer(key, attributes);
    if (reduced.hidden) continue;
    const display = renderer.getNodeDisplayData(key);
    if (!display) continue;
    // The ring has to hug the circle sigma actually drew. It used to be
    // floored at a fixed radius, so a node too small to see still got a full
    // sized outline: a stray diamond floating in open space, with nothing
    // inside it and nothing to click, because sigma's hit area is the real
    // node. Below a couple of pixels the shape carries no information anyway,
    // so it is not drawn.
    const drawn = renderer.scaleSize(display.size);
    if (drawn < MIN_SHAPE_RADIUS) continue;
    const point = renderer.graphToViewport(display);
    context.strokeStyle = reduced.color || attributes.color;
    drawShape(context, shape, point.x, point.y, Math.min(drawn, MAX_SHAPE_RADIUS) + 2.5);
  }
}

function fitScene() {
  if (!renderer) return;
  const state = State.cam || { x: 0.5, y: 0.5, ratio: sceneSpec && sceneSpec.layout === "layered" ? 1.3 : 1.22 };
  renderer.getCamera().setState({ x: state.x, y: state.y, ratio: state.ratio, angle: 0 });
}

let cameraTimer = null;
function scheduleCameraWrite() {
  clearTimeout(cameraTimer);
  cameraTimer = setTimeout(() => {
    if (!renderer) return;
    const { x, y, ratio } = renderer.getCamera().getState();
    State.cam = { x, y, ratio };
    writeUrl(false);
  }, 400);
}

function renderSceneStatus(spec) {
  const parts = [];
  if (spec.caption) parts.push(spec.caption);
  if (spec.omitted) parts.push(`${spec.omitted} more hidden by the scene cap`);
  document.getElementById("status-counts").textContent =
    `${parts.join(" · ")}${parts.length ? " · " : ""}${nodes.length} nodes · ${links.length} edges · ${communityCount} modules`;
  const empty = document.getElementById("empty-state");
  empty.hidden = !spec.empty;
  if (spec.empty) empty.textContent = spec.empty;
  if (spec.omitted) notice(`Scene capped at ${MAX_SCENE_NODES} nodes — ${spec.omitted} more are hidden. Narrow the depth or filters to see them.`);
}

// --- Panels -----------------------------------------------------------------
function escapeHtml(s) {
  return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}
function wikiSlug(path) {
  return path.replace(/[/\\.]/g, "_");
}

// --- Syntax highlighting (file modal) -----------------------------------------
// Tiny line-based tokenizer, not a real parser: comments, strings, numbers,
// keywords, Capitalized types. Good enough to make source readable; anything
// unrecognized falls through unstyled.
const LANG_KEYWORDS = {
  rust: "as async await break const continue crate dyn else enum extern false fn for if impl in let loop match mod move mut pub ref return self Self static struct super trait true type unsafe use where while",
  js: "async await break case catch class const continue debugger default delete do else export extends finally for from function if import in instanceof let new null of return static super switch this throw try typeof undefined var void while yield true false",
  py: "and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return try while with yield None True False self",
  go: "break case chan const continue default defer else fallthrough for func go goto if import interface map package range return select struct switch type var nil true false",
  sh: "if then else elif fi for while until do done case esac function local export return exit echo",
  conf: "",
};
const EXT_LANG = { rs: "rust", js: "js", jsx: "js", ts: "js", tsx: "js", mjs: "js", cjs: "js", py: "py", go: "go", sh: "sh", bash: "sh", zsh: "sh", toml: "conf", yml: "conf", yaml: "conf", json: "conf", ini: "conf" };
const LINE_COMMENT = { rust: "//", js: "//", go: "//", py: "#", sh: "#", conf: "#" };
const BLOCK_COMMENT = { rust: true, js: true, go: true };
const KEYWORD_SETS = Object.fromEntries(Object.entries(LANG_KEYWORDS).map(([l, w]) => [l, new Set(w.split(" ").filter(Boolean))]));
const TOKEN_RES = {};
function tokenRegex(lang) {
  if (TOKEN_RES[lang]) return TOKEN_RES[lang];
  const parts = [];
  if (BLOCK_COMMENT[lang]) parts.push("\\/\\*[\\s\\S]*?\\*\\/", "\\/\\*.*$");
  const lc = LINE_COMMENT[lang];
  if (lc === "//") parts.push("\\/\\/.*$");
  else if (lc === "#") parts.push("#.*$");
  parts.push('"(?:[^"\\\\]|\\\\.)*"?', "'(?:[^'\\\\]|\\\\.)*'?", "`[^`]*`?");
  parts.push("\\b0[xX][0-9a-fA-F_]+\\b", "\\b\\d[\\d_]*(?:\\.\\d+)?\\b");
  parts.push("\\b[A-Za-z_]\\w*\\b");
  TOKEN_RES[lang] = new RegExp(parts.join("|"), "g");
  return TOKEN_RES[lang];
}
function langOf(file) {
  const ext = file.slice(file.lastIndexOf(".") + 1).toLowerCase();
  return EXT_LANG[ext] || null;
}
// `st.block` carries an open /* ... */ across lines.
function highlightLine(raw, lang, st) {
  if (!lang) return escapeHtml(raw);
  let out = "";
  let rest = raw;
  if (st.block) {
    const end = rest.indexOf("*/");
    if (end === -1) return `<span class="tk-c">${escapeHtml(rest)}</span>`;
    out += `<span class="tk-c">${escapeHtml(rest.slice(0, end + 2))}</span>`;
    st.block = false;
    rest = rest.slice(end + 2);
  }
  const kw = KEYWORD_SETS[lang];
  const re = tokenRegex(lang);
  re.lastIndex = 0;
  let last = 0;
  let m;
  while ((m = re.exec(rest)) !== null) {
    out += escapeHtml(rest.slice(last, m.index));
    const tok = m[0];
    let cls = null;
    const c0 = tok[0];
    if (tok.startsWith("//") || (c0 === "#" && LINE_COMMENT[lang] === "#")) cls = "tk-c";
    else if (tok.startsWith("/*")) {
      cls = "tk-c";
      if (!tok.endsWith("*/")) st.block = true;
    } else if (c0 === '"' || c0 === "'" || c0 === "`") cls = "tk-s";
    else if (c0 >= "0" && c0 <= "9") cls = "tk-n";
    else if (kw.has(tok)) cls = "tk-k";
    else if (c0 >= "A" && c0 <= "Z") cls = "tk-t";
    out += cls ? `<span class="${cls}">${escapeHtml(tok)}</span>` : escapeHtml(tok);
    last = m.index + tok.length;
  }
  out += escapeHtml(rest.slice(last));
  return out;
}

function openFile(file, startLine, endLine) {
  const content = FILES[file];
  document.getElementById("fm-title").textContent = file;
  // Beyond the page's source budget a file's text is not embedded. Say so and
  // give the reader the location, rather than opening an empty modal.
  if (content === undefined) {
    document.getElementById("fm-body").innerHTML =
      `<div class="fm-missing">Source not embedded in this page &mdash; ${FILES_OMITTED} file(s) exceeded the offline source budget.` +
      `<br><br><code>${escapeHtml(file)}</code>${startLine ? `, line ${startLine}` : ""}<br><br>Open it in your editor to read it.</div>`;
    document.getElementById("filemodal").style.display = "flex";
    return;
  }
  const lang = langOf(file);
  const st = { block: false };
  const lines = content.split("\n");
  const body = lines
    .map((line, i) => {
      const n = i + 1;
      const hl = n >= startLine && n <= endLine ? " hl" : "";
      return `<div class="fm-line${hl}" data-line="${n}"><span class="fm-no">${n}</span><span class="fm-code">${highlightLine(line, lang, st)}</span></div>`;
    })
    .join("");
  const modal = document.getElementById("filemodal");
  const fmBody = document.getElementById("fm-body");
  fmBody.innerHTML = body;
  modal.style.display = "flex";
  const target = fmBody.querySelector(`[data-line="${startLine}"]`);
  if (target) target.scrollIntoView({ block: "center" });
}

document.getElementById("fm-close").addEventListener("click", () => {
  document.getElementById("filemodal").style.display = "none";
});
document.getElementById("filemodal").addEventListener("click", (event) => {
  if (event.target.id === "filemodal") event.target.style.display = "none";
});
// Escape unwinds one layer at a time: modal, chat, then the graph itself
// (handled with the rest of the keyboard map further down).
document.addEventListener("keydown", (event) => {
  if (event.key !== "Escape") return;
  const modal = document.getElementById("filemodal");
  if (modal.style.display === "flex") {
    modal.style.display = "none";
    event.stopPropagation();
    return;
  }
  const chat = document.getElementById("chat-panel");
  if (chat.classList.contains("open")) {
    toggleChat(false);
    event.stopPropagation();
  }
});

document.getElementById("search").addEventListener("input", (event) => {
  searchQuery = event.target.value.trim().toLowerCase();
  if (renderer) renderer.refresh();
});
document.getElementById("search").addEventListener("keydown", (event) => {
  if (event.key !== "Enter" || !searchQuery) return;
  const hit =
    nodes.find((node) => nodeAllowed(node) && node.name.toLowerCase() === searchQuery) ||
    nodes.find((node) => nodeAllowed(node) && node.name.toLowerCase().includes(searchQuery));
  if (hit) setState({ mode: State.mode === "overview" ? "explore" : State.mode, focus: String(hit.id) }, { push: true });
});

// --- AI chat -----------------------------------------------------------------
// Multi-provider chat grounded on this graph (SPEC section 8, task 3).
// The page is static and offline, so the browser calls the provider directly
// with the user's own key — Anthropic via /v1/messages (with the documented
// browser-access header), OpenAI via /v1/chat/completions, Ollama locally.
// The key never touches any server of ours; it lives in localStorage only.
function toggleChat(force) {
  const chat = document.getElementById("chat-panel");
  const open = force !== undefined ? force : !chat.classList.contains("open");
  chat.classList.toggle("open", open);
  document.getElementById("chat-btn").classList.toggle("active", open);
  if (open) {
    document.getElementById("panel").style.display = "none";
    document.getElementById("chat-text").focus();
  }
}
document.getElementById("chat-btn").addEventListener("click", () => toggleChat());

// Provider registry — same roster GitNexus exposes. `compat` marks an
// OpenAI-compatible /chat/completions endpoint; anthropic/gemini/azure have
// their own wire formats. Colors follow the samvrai spectrum.
const CHAT_PROVIDERS = {
  anthropic:      { label: "Anthropic",  color: "#ff8a3b", model: "claude-opus-4-8", needsKey: true },
  openai:         { label: "OpenAI",     color: "#3bff6e", model: "gpt-4o-mini", compat: "https://api.openai.com/v1", needsKey: true },
  "azure-openai": { label: "Azure",      color: "#3bd8ff", model: "gpt-4o-mini", needsKey: true, needsUrl: true, urlLabel: "Azure endpoint", urlPlaceholder: "https://<resource>.openai.azure.com" },
  gemini:         { label: "Gemini",     color: "#7a3bff", model: "gemini-2.0-flash", needsKey: true },
  openrouter:     { label: "OpenRouter", color: "#ff3b3b", model: "openrouter/auto", compat: "https://openrouter.ai/api/v1", needsKey: true },
  minimax:        { label: "MiniMax",    color: "#f06292", model: "MiniMax-M2", compat: "https://api.minimax.io/v1", needsKey: true },
  glm:            { label: "GLM",        color: "#ffcf3b", model: "glm-4.6", compat: "https://api.z.ai/api/paas/v4", needsKey: true },
  ollama:         { label: "Ollama",     color: "#f2f2ee", model: "llama3.1", needsUrl: true, urlLabel: "Ollama URL", urlPlaceholder: "http://localhost:11434", defaultUrl: "http://localhost:11434" },
};
let chatCfg = {
  provider: "anthropic",
  keys: {},
  urls: { ollama: "http://localhost:11434" },
  models: {},
  ...JSON.parse(localStorage.getItem("aag-chat-config") || "{}"),
};
// migrate the earlier single-key shape
if (chatCfg.key && !chatCfg.keys[chatCfg.provider]) chatCfg.keys[chatCfg.provider] = chatCfg.key;
if (chatCfg.url && !chatCfg.urls.ollama) chatCfg.urls.ollama = chatCfg.url;
chatCfg.keys = chatCfg.keys || {};
chatCfg.urls = chatCfg.urls || {};
for (const [p, def] of Object.entries(CHAT_PROVIDERS)) {
  if (!chatCfg.models[p]) chatCfg.models[p] = def.model;
}
if (!CHAT_PROVIDERS[chatCfg.provider]) chatCfg.provider = "anthropic";
function saveChatCfg() { localStorage.setItem("aag-chat-config", JSON.stringify(chatCfg)); }
const chatKey = () => chatCfg.keys[chatCfg.provider] || "";
const chatUrl = () => chatCfg.urls[chatCfg.provider] || CHAT_PROVIDERS[chatCfg.provider].defaultUrl || "";

// Stable graph digest: goes first in the system prompt so Anthropic's prompt
// cache (prefix match) can reuse it across questions.
const CHAT_SYSTEM = (() => {
  const files = nodes.filter((n) => n.kind === "file");
  const fileLines = files
    .map((f) => {
      const syms = nodes.filter((n) => n.file === f.file && n.kind !== "file" && n.kind !== "doc").length;
      return `- ${f.file} (${syms} symbols)`;
    })
    .join("\n");
  const hubs = nodes
    .slice()
    .sort((a, b) => b.degree - a.degree)
    .slice(0, 14)
    .map((n) => `- ${n.name} (${n.kind}, ${n.file}:${n.startLine}, ${n.degree} connections)`)
    .join("\n");
  const mods = communityMeta.map((m) => `- ${m.name} (${m.size} nodes)`).join("\n");
  return (
    `You are the assistant embedded in aag ("above all graphs"), an offline code-graph explorer. ` +
    `You are looking at the indexed repository "__REPO_NAME__" (${nodes.length} nodes, ${links.length} edges). ` +
    `Answer questions about this codebase using the graph data and source snippets provided. ` +
    `Cite locations as file:line. If the provided context is not enough, say what is missing instead of guessing.\n\n` +
    `Files:\n${fileLines}\n\nMost connected symbols:\n${hubs}\n\nModules (detected communities):\n${mods}`
  );
})();

// Per-question retrieval: match query words against node names/files, ship
// the best nodes with their edges and a source slice as context.
function chatRetrieve(question) {
  const words = [...new Set(question.toLowerCase().match(/[a-z_][a-z0-9_]{2,}/g) || [])];
  if (words.length === 0) return "";
  const scored = [];
  for (const n of nodes) {
    const name = n.name.toLowerCase();
    const file = n.file.toLowerCase();
    let score = 0;
    for (const w of words) {
      if (name === w) score += 6;
      else if (name.includes(w)) score += 3;
      if (file.includes(w)) score += 1;
    }
    if (score > 0) scored.push([score + Math.min(n.degree, 10) * 0.1, n]);
  }
  scored.sort((a, b) => b[0] - a[0]);
  const parts = [];
  let budget = 9000;
  for (const [, n] of scored.slice(0, 6)) {
    const callers = links.filter((l) => l.target === n.id).slice(0, 8).map((l) => `${l.s.name} (${l.s.file}:${l.s.startLine})`);
    const callees = links.filter((l) => l.source === n.id).slice(0, 8).map((l) => `${l.t.name} (${l.t.file}:${l.t.startLine})`);
    let block = `### ${n.kind} ${n.name} — ${n.file}:${n.startLine}-${n.endLine}\n`;
    if (callers.length) block += `Called by: ${callers.join(", ")}\n`;
    if (callees.length) block += `Calls: ${callees.join(", ")}\n`;
    const src = FILES[n.file];
    if (src && n.kind !== "file" && n.kind !== "doc") {
      const all = src.split("\n");
      const from = Math.max(0, n.startLine - 1);
      const to = Math.min(all.length, Math.min(n.endLine, n.startLine + 60));
      block += "```\n" + all.slice(from, to).join("\n") + "\n```\n";
    }
    if (budget - block.length < 0) break;
    budget -= block.length;
    parts.push(block);
  }
  return parts.length ? `\n\n<graph_context>\n${parts.join("\n")}</graph_context>` : "";
}

const chatHistory = []; // [{role, content}] — full contents incl. retrieval blocks
let chatAbort = null;

function chatMdLite(text) {
  // fences first, then inline code, on escaped text
  const esc = escapeHtml(text);
  let out = "";
  const segs = esc.split(/```[a-zA-Z]*\n?/);
  for (let i = 0; i < segs.length; i++) {
    if (i % 2 === 1) out += `<pre><code>${segs[i]}</code></pre>`;
    else out += segs[i].replace(/`([^`\n]+)`/g, "<code>$1</code>");
  }
  return out;
}

function chatAddMsg(cls, who) {
  const msgs = document.getElementById("chat-msgs");
  const empty = msgs.querySelector(".empty");
  if (empty) empty.remove();
  const div = document.createElement("div");
  div.className = `msg ${cls}`;
  div.innerHTML = `<div class="who">${who}</div><div class="body"></div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
  return div.querySelector(".body");
}

// Shared line reader over a streaming fetch body.
async function chatReadLines(resp, onLine) {
  const reader = resp.body.getReader();
  const dec = new TextDecoder();
  let buf = "";
  for (;;) {
    const { done, value } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });
    const lines = buf.split("\n");
    buf = lines.pop();
    for (const line of lines) onLine(line);
  }
  if (buf) onLine(buf);
}

// OpenAI-compatible SSE — serves OpenAI, OpenRouter, MiniMax, GLM and Azure
// (Azure differs only in URL shape and auth header).
async function openaiCompatStream(url, headers, model, onText, signal) {
  const resp = await fetch(url, {
    method: "POST",
    signal,
    headers: { "content-type": "application/json", ...headers },
    body: JSON.stringify({
      model,
      stream: true,
      messages: [{ role: "system", content: CHAT_SYSTEM }, ...chatHistory],
    }),
  });
  if (!resp.ok) throw new Error(await chatApiError(resp));
  await chatReadLines(resp, (line) => {
    if (!line.startsWith("data: ") || line.includes("[DONE]")) return;
    const data = JSON.parse(line.slice(6));
    const text = data.choices?.[0]?.delta?.content;
    if (text) onText(text);
  });
}

async function chatStream(onText, signal) {
  const p = chatCfg.provider;
  const def = CHAT_PROVIDERS[p];
  const model = chatCfg.models[p];
  const key = chatKey();
  if (p === "anthropic") {
    const resp = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST",
      signal,
      headers: {
        "content-type": "application/json",
        "x-api-key": key,
        "anthropic-version": "2023-06-01",
        "anthropic-dangerous-direct-browser-access": "true",
      },
      body: JSON.stringify({
        model,
        max_tokens: 64000,
        stream: true,
        system: [{ type: "text", text: CHAT_SYSTEM, cache_control: { type: "ephemeral" } }],
        messages: chatHistory,
      }),
    });
    if (!resp.ok) throw new Error(await chatApiError(resp));
    await chatReadLines(resp, (line) => {
      if (!line.startsWith("data: ")) return;
      const data = JSON.parse(line.slice(6));
      if (data.type === "content_block_delta" && data.delta.type === "text_delta") onText(data.delta.text);
      if (data.type === "error") throw new Error(data.error.message);
    });
  } else if (p === "gemini") {
    const contents = chatHistory.map((m) => ({ role: m.role === "assistant" ? "model" : "user", parts: [{ text: m.content }] }));
    const resp = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:streamGenerateContent?alt=sse&key=${encodeURIComponent(key)}`,
      {
        method: "POST",
        signal,
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ systemInstruction: { parts: [{ text: CHAT_SYSTEM }] }, contents }),
      }
    );
    if (!resp.ok) throw new Error(await chatApiError(resp));
    await chatReadLines(resp, (line) => {
      if (!line.startsWith("data: ")) return;
      const data = JSON.parse(line.slice(6));
      const parts = data.candidates?.[0]?.content?.parts || [];
      for (const part of parts) if (part.text) onText(part.text);
    });
  } else if (p === "azure-openai") {
    const base = chatUrl().replace(/\/$/, "");
    if (!base) throw new Error("Set your Azure endpoint URL first (⚙).");
    await openaiCompatStream(
      `${base}/openai/deployments/${encodeURIComponent(model)}/chat/completions?api-version=2024-10-21`,
      { "api-key": key },
      model,
      onText,
      signal
    );
  } else if (def.compat) {
    await openaiCompatStream(`${def.compat}/chat/completions`, { authorization: `Bearer ${key}` }, model, onText, signal);
  } else {
    // ollama
    const base = chatUrl().replace(/\/$/, "");
    let resp;
    try {
      resp = await fetch(`${base}/api/chat`, {
        method: "POST",
        signal,
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          model,
          stream: true,
          messages: [{ role: "system", content: CHAT_SYSTEM }, ...chatHistory],
        }),
      });
    } catch (e) {
      throw new Error(`Could not reach Ollama at ${base}. Is it running? For pages opened from file://, start it with OLLAMA_ORIGINS="*".`);
    }
    if (!resp.ok) throw new Error(await chatApiError(resp));
    await chatReadLines(resp, (line) => {
      if (!line.trim()) return;
      const data = JSON.parse(line);
      if (data.message?.content) onText(data.message.content);
      if (data.error) throw new Error(data.error);
    });
  }
}

async function chatApiError(resp) {
  try {
    const j = await resp.json();
    return j.error?.message || j.error || `HTTP ${resp.status}`;
  } catch {
    return `HTTP ${resp.status}`;
  }
}

async function chatSend() {
  const ta = document.getElementById("chat-text");
  const btn = document.getElementById("chat-send");
  const question = ta.value.trim();
  if (!question || chatAbort) return;
  if (CHAT_PROVIDERS[chatCfg.provider].needsKey && !chatKey()) {
    toggleChatConfig(true);
    chatAddMsg("assistant err", "aag").textContent = "Set an API key first (⚙ in the chat header).";
    return;
  }
  ta.value = "";
  chatAddMsg("user", "you").textContent = question;
  chatHistory.push({ role: "user", content: question + chatRetrieve(question) });

  const body = chatAddMsg("assistant", chatCfg.provider);
  body.textContent = "…";
  btn.textContent = "■";
  btn.classList.add("stop");
  chatAbort = new AbortController();
  let full = "";
  const msgs = document.getElementById("chat-msgs");
  try {
    await chatStream((text) => {
      if (full === "") body.textContent = "";
      full += text;
      body.textContent = full;
      msgs.scrollTop = msgs.scrollHeight;
    }, chatAbort.signal);
    body.innerHTML = chatMdLite(full);
    chatHistory.push({ role: "assistant", content: full });
  } catch (e) {
    if (e.name === "AbortError") {
      if (full) chatHistory.push({ role: "assistant", content: full });
      body.innerHTML = chatMdLite(full) + `<div style="color:var(--text-dim)">— stopped —</div>`;
    } else {
      chatHistory.pop(); // failed turn: drop the user message so a retry is clean
      body.parentElement.classList.add("err");
      body.textContent = String(e.message || e);
    }
  } finally {
    chatAbort = null;
    btn.textContent = "→";
    btn.classList.remove("stop");
    msgs.scrollTop = msgs.scrollHeight;
  }
}

document.getElementById("chat-send").addEventListener("click", () => {
  if (chatAbort) chatAbort.abort();
  else chatSend();
});
document.getElementById("chat-text").addEventListener("keydown", (event) => {
  if (event.key === "Enter" && !event.shiftKey) {
    event.preventDefault();
    chatSend();
  }
});

