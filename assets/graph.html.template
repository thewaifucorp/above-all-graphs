}

function visible(element) {
  return !!(element && element.offsetWidth && element.offsetHeight);
}
window.addEventListener("resize", () => {
  if (renderer && visible(document.getElementById("view"))) renderer.resize();
});

document.getElementById("tab-btn-explorer").addEventListener("click", () => selectTab("explorer"));
document.getElementById("tab-btn-filters").addEventListener("click", () => selectTab("filters"));
document.getElementById("palette-input").addEventListener("input", (event) => renderPalette(event.target.value));

readUrl();
buildModeSwitcher();
buildTree();
buildFilters();
selectTab("explorer");
applyState();
writeUrl(false);
</script>
</body>
</html>
