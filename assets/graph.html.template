function buildLegend() {
  const host = document.getElementById("legend-list");
  const ranked = communityMeta
    .filter((meta) => meta.id !== UNGROUPED && meta.size > 0)
    .slice()
    .sort((left, right) => right.size - left.size)
    .slice(0, 40);
  host.innerHTML = ranked
    .map(
      (meta) =>
        `<div class="row${State.community === meta.id ? " on" : ""}" data-c="${meta.id}" tabindex="0" role="button" title="${escapeHtml(meta.name)}">` +
        `<span class="swatch" style="background:${communityColor(meta.id)}"></span>` +
        `<span class="name">${escapeHtml(meta.label)}</span><span class="n">${meta.size}</span></div>`
    )
    .join("");
  for (const row of host.querySelectorAll(".row")) {
    const toggle = () => {
      const id = Number(row.dataset.c);
      setState({ community: State.community === id ? null : id });
    };
