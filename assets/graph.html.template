  }
}

function enterMode(mode) {
  if (!MODE_IDS.includes(mode) || mode === State.mode) return;
  setState({ mode }, { push: true });
}

let noticeTimer = null;
// A shared link can name a symbol that has since been renamed or deleted, and
// a scene can be capped. Say so — degrading silently is how a reader concludes
// the tool is broken.
function notice(message) {
  const host = document.getElementById("notice");
  if (!message) {
    host.hidden = true;
    return;
  }
  host.textContent = message;
  host.hidden = false;
  clearTimeout(noticeTimer);
  noticeTimer = setTimeout(() => {
    host.hidden = true;
  }, 6000);
}

function resolveFocus(value) {
  if (value === null || value === undefined || value === "") return null;
  const numeric = Number(value);
  if (Number.isInteger(numeric) && byId.has(numeric)) return byId.get(numeric);
  const exact =
    nodes.find((node) => node.file === value && node.kind === "file") ||
    nodes.find((node) => node.name === value) ||
    nodes.find((node) => node.file === value);
  if (exact) return exact;
  // Typing is not dictation. `bigbang` should find `src/bigbang.rs`, and case
  // should not decide whether a path resolves. Most connected wins, so the
  // loose match lands on the symbol someone probably meant.
  const lowered = String(value).toLowerCase();
  const candidates = nodes.filter(
    (node) =>
      (node.name || "").toLowerCase() === lowered ||
      (node.file || "").toLowerCase() === lowered ||
      (node.file || "").toLowerCase().endsWith(`/${lowered}`) ||
      (node.kind === "file" && (node.file || "").toLowerCase().split("/").pop()?.split(".")[0] === lowered)
  );
  if (!candidates.length) return null;
  return candidates.reduce((best, node) => ((node.degree || 0) > (best.degree || 0) ? node : best));
}

// --- Inspector ---------------------------------------------------------------
// One panel for symbols, aggregates, paths, and contracts, because a reader
// should not have to learn a second place to look.
function inspect(key) {
  const attributes = scene.getNodeAttributes(key);
  if (attributes._overflow) {
    inspectOverflow(attributes._overflow);
    return;
  }
  if (attributes._aggregate) {
    inspectAggregate(attributes._aggregate);
    return;
  }
  const node = attributes._node;
  if (!node) return;
  selected = node;
  renderer.refresh();
  inspectNode(node, attributes);
}

function factRow(term, value) {
  return `<dt>${term}</dt><dd>${value}</dd>`;
}

function relationRows(list, label) {
  if (!list.length) return "";
  const rows = list
    .slice(0, 12)
    .map((entry) => {
      const other = entry.node;
      return (
        `<div class="callrow" data-node="${other.id}" tabindex="0" role="button">` +
        `<span class="cname">${escapeHtml(nodeLabel(other))}</span>` +
        `<span class="cfile">${escapeHtml(entry.edge.kind)} · ${entry.edge.confidence.toLowerCase()} · ${escapeHtml(other.file)}</span></div>`
      );
    })
    .join("");
  const more = list.length > 12 ? `<p class="cc-note">${list.length - 12} more</p>` : "";
  return `<h4>${label} (${list.length})</h4>${rows}${more}`;
}

function inspectNode(node, attributes) {
  const panel = document.getElementById("panel");
  const callers = (incoming.get(node.id) || [])
    .filter(edgeAllowed)
    .map((edge) => ({ edge, node: byId.get(edge.source) }))
    .filter((entry) => entry.node);
  const callees = (outgoing.get(node.id) || [])
    .filter(edgeAllowed)
    .map((edge) => ({ edge, node: byId.get(edge.target) }))
    .filter((entry) => entry.node);
  const meta = communityMeta[node.community] || {};
  const impact = attributes && attributes._impact;
  panel.innerHTML = `
    <h3>${escapeHtml(nodeLabel(node))}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(node.community)}"></span>${escapeHtml(meta.label || "unconnected")}</p>
    <dl class="agg-facts">
      ${factRow("kind", escapeHtml(node.kind))}
      ${factRow("location", `${escapeHtml(node.file)}:${node.startLine}`)}
      ${factRow("perspective", escapeHtml(node.perspective || "observed"))}
      ${factRow("degree", node.degree || 0)}
      ${factRow("incoming / outgoing", `${callers.length} / ${callees.length}`)}
      ${ENTRYPOINTS.has(node.id) ? factRow("entrypoint", "yes") : ""}
      ${impact ? factRow("impact", escapeHtml(impact)) : ""}
    </dl>
    <div class="agg-actions">
      <button data-act="explore">Explore here</button>
      <button data-act="impact">Impact</button>
      <button data-act="path-from">Path from</button>
      <button data-act="path-to">Path to</button>
      <button data-act="pin">${State.pins.has(node.id) ? "Unpin" : "Pin"}</button>
      <button data-act="source">Open source</button>
      <a href="wiki/${wikiSlug(node.file)}.html">wiki</a>
    </div>
    ${relationRows(callers, "Incoming")}
    ${relationRows(callees, "Outgoing")}
  `;
  panel.classList.add("open");
  const act = {
    explore: () => setState({ mode: "explore", focus: String(node.id) }, { push: true }),
    impact: () => setState({ mode: "impact", focus: String(node.id) }, { push: true }),
    "path-from": () => setState({ mode: "path", from: String(node.id) }, { push: true }),
    "path-to": () => setState({ mode: "path", to: String(node.id) }, { push: true }),
    pin: () => {
      const pins = new Set(State.pins);
      pins.has(node.id) ? pins.delete(node.id) : pins.add(node.id);
      setState({ pins });
    },
    source: () => openFile(node.file, node.startLine, node.endLine),
  };
  for (const button of panel.querySelectorAll("[data-act]")) {
    button.addEventListener("click", () => act[button.dataset.act] && act[button.dataset.act]());
  }
  for (const row of panel.querySelectorAll("[data-node]")) {
    const go = () => {
      const target = byId.get(Number(row.dataset.node));
      if (target) setState({ mode: "explore", focus: String(target.id) }, { push: true });
    };
    row.addEventListener("click", go);
    row.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        go();
      }
    });
  }
}

// The scene cap is a budget, not a judgement: say exactly what it held back
// and offer to show it.
function inspectOverflow(overflow) {
  const panel = document.getElementById("panel");
  const meta = communityMeta[overflow.community] || {};
  const rows = overflow.members
    .slice(0, 20)
    .map((id) => byId.get(id))
    .filter(Boolean)
    .map(
      (node) =>
        `<div class="callrow" data-node="${node.id}" tabindex="0" role="button"><span class="cname">${escapeHtml(nodeLabel(node))}</span><span class="cfile">${escapeHtml(node.file)}</span></div>`
    )
    .join("");
  panel.innerHTML = `
    <h3>${overflow.members.length} more in ${escapeHtml(meta.label || "#" + overflow.community)}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(overflow.community)}"></span>held back by the ${MAX_SCENE_NODES}-node scene cap</p>
    <div class="agg-actions">
      <button data-act="expand">Show them</button>
    </div>
    ${rows}
    ${overflow.members.length > 20 ? `<p class="cc-note">${overflow.members.length - 20} not listed</p>` : ""}
  `;
  panel.classList.add("open");
  panel.querySelector('[data-act="expand"]').addEventListener("click", () => {
    const expanded = new Set(State.expanded);
    expanded.add(overflow.community);
    setState({ expanded });
  });
  for (const row of panel.querySelectorAll("[data-node]")) {
    row.addEventListener("click", () => setState({ focus: row.dataset.node }, { push: true }));
  }
}

function inspectAggregate(community) {
  const panel = document.getElementById("panel");
  const meta = communityMeta[community.id] || {};
  const total = community.internalEdges + community.externalEdges;
  const cohesion = total ? Math.round((community.internalEdges / total) * 100) : 0;
  const representatives = community.representatives
    .map((id) => byId.get(id))
    .filter(Boolean)
    .map(
      (node) =>
        `<div class="callrow" data-node="${node.id}" tabindex="0" role="button"><span class="cname">${escapeHtml(nodeLabel(node))}</span><span class="cfile">${escapeHtml(node.file)}</span></div>`
    )
    .join("");
  const bundles = BUNDLES.filter((bundle) => bundle.a === community.id || bundle.b === community.id)
    .sort((left, right) => right.count - left.count)
    .slice(0, 8)
    .map((bundle) => {
      const other = bundle.a === community.id ? bundle.b : bundle.a;
      const otherMeta = communityMeta[other] || {};
      return `<div class="callrow"><span class="cname">${bundle.kind} &times;${bundle.count}</span><span class="cfile">${escapeHtml(otherMeta.label || "#" + other)} · ${bundle.ambiguous} ambiguous</span></div>`;
    })
    .join("");
  panel.innerHTML = `
    <h3>${escapeHtml(meta.label || "#" + community.id)}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(community.id)}"></span>module aggregate</p>
    <dl class="agg-facts">
      ${factRow("symbols", community.members.length)}
      ${factRow("internal edges", community.internalEdges)}
      ${factRow("external edges", community.externalEdges)}
      ${factRow("cohesion", `${cohesion}%`)}
      ${factRow("entrypoints", community.entrypoints)}
      ${factRow("worst confidence", String(community.worstConfidence || "").toLowerCase())}
    </dl>
    <div class="agg-actions">
      <button data-act="toggle">${State.expanded.has(community.id) ? "Collapse" : "Expand"} in place</button>
      <button data-act="isolate">${State.community === community.id ? "Show all" : "Isolate"}</button>
      <button data-act="explore">Explore this module</button>
    </div>
    ${representatives ? `<h4>Most connected</h4>${representatives}` : ""}
    ${bundles ? `<h4>Connects to</h4>${bundles}` : ""}
  `;
  panel.classList.add("open");
  const act = {
    toggle: () => {
      const expanded = new Set(State.expanded);
      expanded.has(community.id) ? expanded.delete(community.id) : expanded.add(community.id);
      setState({ expanded });
    },
    isolate: () => setState({ community: State.community === community.id ? null : community.id }),
    explore: () => {
      const target = byId.get(community.representatives[0]);
      setState({ mode: "explore", focus: target ? String(target.id) : null, community: community.id }, { push: true });
    },
  };
  for (const button of panel.querySelectorAll("[data-act]")) {
    button.addEventListener("click", () => act[button.dataset.act] && act[button.dataset.act]());
  }
  for (const row of panel.querySelectorAll("[data-node]")) {
    row.addEventListener("click", () => {
      const target = byId.get(Number(row.dataset.node));
      if (target) setState({ mode: "explore", focus: String(target.id), community: community.id }, { push: true });
    });
  }
}

// --- Mode chrome -------------------------------------------------------------
// Depth and endpoint controls belong to the modes that use them, and appear
// only there.
function renderModeControls() {
  const host = document.getElementById("mode-controls");
  const parts = [];
  if (State.mode === "explore" || State.mode === "impact") {
    parts.push(
      `<label>upstream <input id="ctl-up" type="number" min="0" max="6" value="${State.up}"></label>`,
      `<label>downstream <input id="ctl-down" type="number" min="0" max="6" value="${State.down}"></label>`
    );
  }
  if (State.mode === "path") {
    // A typed endpoint that resolves to nothing used to blank the field, which
    // reads as "the app ate my input". Keep the text and let the scene explain.
    const name = (value) => {
      if (!value) return "";
      const node = resolveFocus(value);
      return node ? node.name || node.file : String(value);
    };
    // Typing an exact symbol name from memory is not a user interface. The
    // same list the search box uses backs both endpoints, and "use selection"
    // fills one from whatever is currently selected.
    parts.push(
      `<label>from <input id="ctl-from" type="text" list="node-names" value="${escapeHtml(name(State.from))}" placeholder="symbol or file"></label>`,
      `<button id="ctl-from-sel" title="use the selected node">&#8593;</button>`,
      `<label>to <input id="ctl-to" type="text" list="node-names" value="${escapeHtml(name(State.to))}" placeholder="symbol or file"></label>`,
      `<button id="ctl-to-sel" title="use the selected node">&#8593;</button>`,
      `<button id="ctl-swap" title="swap the endpoints">&#8646;</button>`
    );
  }
  if (State.mode === "overview") {
    const total = communityMeta.filter((meta) => meta.id !== UNGROUPED && meta.size > 0).length;
    const allOpen = State.expanded.size >= total && total > 0;
    parts.push(
      `<button id="ctl-expand-all">${allOpen ? "Collapse all" : "Expand all"} modules</button>`,
      `<span class="ctl-note">${State.expanded.size}/${total} expanded &middot; click a bubble to open it</span>`
    );
  }
  host.innerHTML = parts.join("");
  host.hidden = !parts.length;
  const bind = (id, apply) => {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener("change", () => apply(input.value));
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") apply(input.value);
    });
  };
  bind("ctl-up", (value) => setState({ up: clampDepth(value, State.up) }));
  bind("ctl-down", (value) => setState({ down: clampDepth(value, State.down) }));
  bind("ctl-from", (value) => setState({ from: value || null }, { push: true }));
  bind("ctl-to", (value) => setState({ to: value || null }, { push: true }));

  const useSelection = (field) => {
    if (!selected) {
      notice("Select a node first, then use the arrow to make it an endpoint.");
      return;
    }
    setState({ [field]: String(selected.id) }, { push: true });
  };
  document.getElementById("ctl-from-sel")?.addEventListener("click", () => useSelection("from"));
  document.getElementById("ctl-to-sel")?.addEventListener("click", () => useSelection("to"));
  document
    .getElementById("ctl-swap")
    ?.addEventListener("click", () => setState({ from: State.to, to: State.from }, { push: true }));

  document.getElementById("ctl-expand-all")?.addEventListener("click", () => {
    const all = communityMeta.filter((meta) => meta.id !== UNGROUPED && meta.size > 0);
    const open = State.expanded.size >= all.length && all.length > 0;
    if (!open && nodes.length > WHOLE_GRAPH_WARN) {
      // Expanding everything means rendering everything. On a repository this
      // size that is seconds of layout and a scene nobody can read, so say so
      // rather than appearing to hang.
      notice(`Opening all ${nodes.length.toLocaleString()} nodes — this will be slow and dense.`);
    }
    setState({ expanded: open ? new Set() : new Set(all.map((meta) => meta.id)) });
  });
}

/// Every node name, once, for the endpoint pickers. Built lazily because a
/// large repository has tens of thousands of them and the list is only needed
/// when someone opens Path.
let nodeNameList = null;
function ensureNodeNameList() {
  if (nodeNameList) return;
  nodeNameList = document.createElement("datalist");
  nodeNameList.id = "node-names";
  const seen = new Set();
  const options = [];
  for (const node of nodes) {
    const label = node.name || node.file;
    if (!label || seen.has(label)) continue;
    seen.add(label);
    options.push(`<option value="${escapeHtml(label)}"></option>`);
    if (options.length >= 4000) break;
  }
  nodeNameList.innerHTML = options.join("");
  document.body.appendChild(nodeNameList);
}

const SPEC_BUILDERS = {
  overview: overviewSpec,
  explore: exploreSpec,
  path: pathSpec,
  impact: impactSpec,
  contracts: contractsSpec,
};

function applyState() {
  syncFilterSets();
  document.body.dataset.mode = State.mode;
  document.getElementById("legend").hidden = State.mode !== "overview";
  for (const button of document.querySelectorAll("#modes button")) {
    button.setAttribute("aria-selected", String(button.dataset.mode === State.mode));
  }
  if (State.mode === "path") ensureNodeNameList();
  renderModeControls();
  if (State.mode === "overview") buildLegend();
  if (State.focus && !resolveFocus(State.focus)) {
    notice(`No node named "${State.focus}" in this graph.`);
  }
  renderScene((SPEC_BUILDERS[State.mode] || overviewSpec)());
  markTreeActive();
}

window.addEventListener("popstate", () => {
