// --- Layout driver ----------------------------------------------------------
// Iterations scale down with graph size; work is chunked into batches so the
// progress bar paints and the tab never freezes, even at 5k+ nodes.
function runLayout(isRerun) {
  stopSim();
  const total = nodes.length > 5000 ? 160 : nodes.length > 1000 ? 260 : 400;
  const noverlapIters = 60;
  const progress = document.getElementById("progress");
  const fill = document.getElementById("progress-fill");
  // Only a real layout pass raises the overlay; the Overview needs no layout
  // of the full graph and must not sit behind a spinner that never clears.
  if (!isRerun) progress.style.display = "flex";
  let iter = 0;

  function batch() {
    const chunk = nodes.length > 5000 ? 4 : 12;
    for (let i = 0; i < chunk && iter < total; i++, iter++) {
      fa2Step(Math.pow(1 - iter / total, 1.6));
    }
    fill.style.width = `${Math.round((iter / total) * 90)}%`;
    if (isRerun) { syncGraph(); refresh(); }
    if (iter < total) { setTimeout(batch, 0); return; }
    for (let i = 0; i < noverlapIters; i++) { if (noverlapStep() === 0) break; }
    fill.style.width = "100%";
    progress.style.display = "none";
    syncGraph();
    fitView(isRerun ? 500 : 0);
    refresh();
    if (!isRerun) {
      const target = resolveFocus(State.focus);
      if (target) focusNode(target);
      else if (State.focus) notice(`No node named "${State.focus}" in this graph — showing everything instead.`);
    }
    // Small settle kick; decays to sleep unless liveSim keeps a floor.
    startSim(0.03);
  }
  setTimeout(batch, 0);
}

// --- Mode + URL state --------------------------------------------------------
// One store, one writer. Every state worth sharing lives in the query string,
// so any view can be pasted into a review — see the URL schema in
// `docs/graph-experience.md`. Modes not built yet are simply absent from the
// switcher; a dead button is worse than a missing one.
const MODE_LIST = [
  { id: "overview", label: "Overview", hint: "Modules and how they connect" },
  { id: "explore", label: "Explore", hint: "One symbol and its neighbourhood" },
];
const MODE_IDS = MODE_LIST.map((m) => m.id);

const State = {
  mode: "overview",
  focus: null,
  community: null,
  expanded: new Set(),
  rel: null,
  conf: null,
  kind: null,
  pins: new Set(),
  cam: null,
};

const ALL_REL = [...new Set(links.map((e) => e.kind))];
const ALL_CONF = [...new Set(links.map((e) => e.confidence))];
const ALL_KIND = [...new Set(nodes.map((n) => n.kind))];

function parseSet(value, cast) {
  if (!value) return null;
  const parts = value.split(",").map((p) => p.trim()).filter(Boolean);
  return parts.length ? new Set(cast ? parts.map(cast) : parts) : null;
}

function readUrl() {
  const q = new URLSearchParams(location.search);
  const mode = q.get("mode");
  State.mode = MODE_IDS.includes(mode) ? mode : q.get("focus") ? "explore" : "overview";
  State.focus = q.get("focus") || null;
  State.community = q.has("community") ? Number(q.get("community")) : null;
  State.expanded = parseSet(q.get("expanded"), Number) || new Set();
  State.rel = parseSet(q.get("rel"));
  State.conf = parseSet(q.get("conf"), (c) => c.toUpperCase());
  State.kind = parseSet(q.get("kind"));
  State.pins = parseSet(q.get("pin"), Number) || new Set();
  const cam = q.get("cam");
  if (cam) {
    const [x, y, ratio] = cam.split(",").map(Number);
    State.cam = Number.isFinite(x) && Number.isFinite(y) && Number.isFinite(ratio) ? { x, y, ratio } : null;
  } else {
    State.cam = null;
  }
}

function writeUrl(push) {
  const q = new URLSearchParams();
  q.set("mode", State.mode);
  if (State.focus) q.set("focus", State.focus);
  if (State.community !== null) q.set("community", String(State.community));
  if (State.expanded.size) q.set("expanded", [...State.expanded].sort((a, b) => a - b).join(","));
  if (State.rel) q.set("rel", [...State.rel].join(","));
  if (State.conf) q.set("conf", [...State.conf].join(","));
  if (State.kind) q.set("kind", [...State.kind].join(","));
  if (State.pins.size) q.set("pin", [...State.pins].join(","));
  if (State.cam) q.set("cam", `${State.cam.x.toFixed(4)},${State.cam.y.toFixed(4)},${State.cam.ratio.toFixed(4)}`);
  const url = `${location.pathname}?${q.toString()}`;
  // A mode or focus change is a navigation; a filter tweak is not, or the
  // back button would walk one checkbox at a time.
  if (push) history.pushState(null, "", url);
  else history.replaceState(null, "", url);
}

function setState(patch, options) {
  Object.assign(State, patch);
  writeUrl(options && options.push);
  applyState();
}

// Filters are stored as what is *allowed*; the reducers work on what is
// hidden. Translate once, here, so both stay in sync.
function syncFilterSets() {
  hiddenKinds.clear();
  if (State.kind) for (const kind of ALL_KIND) if (!State.kind.has(kind)) hiddenKinds.add(kind);
  hiddenConf.clear();
  if (State.conf) for (const conf of ALL_CONF) if (!State.conf.has(conf)) hiddenConf.add(conf);
  hiddenRel = new Set();
  if (State.rel) for (const rel of ALL_REL) if (!State.rel.has(rel)) hiddenRel.add(rel);
  isolatedCommunity = State.community;
}

function buildModeSwitcher() {
  const host = document.getElementById("modes");
  host.innerHTML = MODE_LIST.map(
    (m, i) =>
      `<button role="tab" data-mode="${m.id}" aria-selected="false" title="${escapeHtml(m.hint)} (${i + 1})">${m.label}</button>`
  ).join("");
  for (const button of host.querySelectorAll("button")) {
    button.addEventListener("click", () => enterMode(button.dataset.mode));
  }
}

function enterMode(mode) {
  if (!MODE_IDS.includes(mode) || mode === State.mode) return;
  setState({ mode }, { push: true });
}

// --- Overview: collapsed communities and the bundles between them ------------
// Opens on ~200 aggregates instead of ~6000 symbols. Every aggregate expands
// to its members, and every bundle reports the relations it stands for, so
// nothing is hidden without saying so.
let ovGraph = null;
let ovRenderer = null;
let ovFingerprint = null;
let ovSelected = null;

function overviewFingerprint() {
  return `${[...State.expanded].sort((a, b) => a - b).join(",")}|${State.community}`;
}

function overviewAnchor(community) {
  return State.expanded.has(community.id) && community.representatives.length
    ? `n${community.representatives[0]}`
    : `c${community.id}`;
}

function overviewLayout(keys, edges, sizeOf) {
  // Deterministic: seeded ring by rank, then a few hundred rounds of
  // attract-along-bundles and repel-all-pairs, then a short no-overlap pass.
  // At ~200 aggregates the naive all-pairs pass is cheaper than setting up a
  // quadtree. Repulsion scales with size, or the few large modules pile on
  // top of each other in the middle while the small ones spread out.
  const positions = new Map();
  const radius = 120 + 22 * Math.sqrt(keys.length);
  keys.forEach((key, index) => {
    const angle = (2 * Math.PI * index) / keys.length;
    positions.set(key, {
      x: Math.cos(angle) * radius,
      y: Math.sin(angle) * radius,
      dx: 0,
      dy: 0,
      r: sizeOf ? sizeOf(key) : 6,
    });
  });
  for (let round = 0; round < 240; round++) {
    const cooling = 1 - round / 240;
    for (const key of keys) {
      const point = positions.get(key);
      point.dx = 0;
      point.dy = 0;
    }
    for (let i = 0; i < keys.length; i++) {
      const a = positions.get(keys[i]);
      for (let j = i + 1; j < keys.length; j++) {
        const b = positions.get(keys[j]);
        let dx = a.x - b.x;
        let dy = a.y - b.y;
        let distanceSquared = dx * dx + dy * dy;
        if (distanceSquared < 1) {
          dx = (i - j) || 1;
          dy = 1;
          distanceSquared = 2;
        }
        const force = (9000 + 900 * (a.r + b.r)) / distanceSquared;
        const distance = Math.sqrt(distanceSquared);
        a.dx += (dx / distance) * force;
        a.dy += (dy / distance) * force;
        b.dx -= (dx / distance) * force;
        b.dy -= (dy / distance) * force;
      }
    }
    for (const edge of edges) {
      const a = positions.get(edge.a);
      const b = positions.get(edge.b);
      if (!a || !b) continue;
      const pull = 0.006 * Math.log(1 + edge.count);
      a.dx += (b.x - a.x) * pull;
      a.dy += (b.y - a.y) * pull;
      b.dx += (a.x - b.x) * pull;
      b.dy += (a.y - b.y) * pull;
    }
    for (const key of keys) {
      const point = positions.get(key);
      point.x += Math.max(-30, Math.min(30, point.dx)) * cooling * 0.25 - point.x * 0.0015;
      point.y += Math.max(-30, Math.min(30, point.dy)) * cooling * 0.25 - point.y * 0.0015;
    }
  }
  // Separate whatever still overlaps. Two aggregates drawn on top of each
  // other read as one module, which is a wrong answer, not a cosmetic one.
  const scale = 3.2;
  for (let round = 0; round < 40; round++) {
    let moved = 0;
    for (let i = 0; i < keys.length; i++) {
      const a = positions.get(keys[i]);
      for (let j = i + 1; j < keys.length; j++) {
        const b = positions.get(keys[j]);
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const distance = Math.sqrt(dx * dx + dy * dy) || 0.01;
        const wanted = (a.r + b.r) * scale;
        if (distance >= wanted) continue;
        const push = (wanted - distance) / 2;
        const ux = dx / distance;
        const uy = dy / distance;
        a.x -= ux * push;
        a.y -= uy * push;
        b.x += ux * push;
        b.y += uy * push;
        moved++;
      }
    }
    if (moved === 0) break;
  }
  return positions;
}

function buildOverview() {
  const fingerprint = overviewFingerprint();
  if (ovGraph && ovFingerprint === fingerprint) return;
  ovFingerprint = fingerprint;

  ovGraph = new graphology.Graph({ multi: true, type: "undirected" });
  const shown = COMMUNITIES.filter((c) => State.community === null || c.id === State.community);
  const anchorOf = new Map();

  for (const community of shown) {
    const meta = communityMeta[community.id] || {};
    if (State.expanded.has(community.id)) {
      for (const id of community.members) {
        const node = byId.get(id);
        if (!node) continue;
        ovGraph.addNode(`n${id}`, {
          label: node.name,
          size: 3 + Math.min(Math.sqrt(node.degree || 0) * 1.6, 9),
          color: communityColor(community.id),
          _member: node,
          _community: community,
        });
      }
    } else {
      ovGraph.addNode(`c${community.id}`, {
        label: `${meta.label || community.label || "#" + community.id} (${community.members.length})`,
        size: 6 + Math.min(Math.sqrt(community.members.length) * 3.2, 26),
        color: communityColor(community.id),
        _aggregate: community,
      });
    }
    anchorOf.set(community.id, overviewAnchor(community));
  }

  // Internal edges only for expanded communities — that is what expanding
  // means. Collapsed communities carry their internal count as a fact.
  if (State.expanded.size) {
    let internal = 0;
    for (const edge of links) {
      const left = edge.s.community;
      if (left !== edge.t.community || !State.expanded.has(left)) continue;
      if (!ovGraph.hasNode(`n${edge.source}`) || !ovGraph.hasNode(`n${edge.target}`)) continue;
      ovGraph.addEdgeWithKey(`i${internal++}`, `n${edge.source}`, `n${edge.target}`, {
        size: 0.6,
        color: EDGE_COLOR,
        _internal: edge,
      });
    }
  }

  let bundleIndex = 0;
  for (const bundle of BUNDLES) {
    const from = anchorOf.get(bundle.a);
    const to = anchorOf.get(bundle.b);
    if (!from || !to || !ovGraph.hasNode(from) || !ovGraph.hasNode(to)) continue;
    ovGraph.addEdgeWithKey(`b${bundleIndex++}`, from, to, {
      size: Math.min(0.6 + Math.log(1 + bundle.count) * 0.9, 6),
      color: bundle.ambiguous > bundle.extracted + bundle.inferred ? "#4a4238" : EDGE_COLOR,
      _bundle: bundle,
    });
  }

  const keys = ovGraph.nodes();
  const bundleEdges = BUNDLES.map((b) => ({ a: anchorOf.get(b.a), b: anchorOf.get(b.b), count: b.count })).filter(
    (e) => e.a && e.b && ovGraph.hasNode(e.a) && ovGraph.hasNode(e.b)
  );
  const positions = overviewLayout(keys, bundleEdges, (key) => ovGraph.getNodeAttribute(key, "size") || 6);
  for (const key of keys) {
    const point = positions.get(key);
    ovGraph.mergeNodeAttributes(key, { x: point.x, y: point.y });
  }

  if (ovRenderer) {
    ovRenderer.kill();
    ovRenderer = null;
  }
  ovRenderer = new Sigma(ovGraph, document.getElementById("view-overview"), {
    // Switching modes hides this container. A hidden container is a normal
    // state here, not a misconfiguration, so sigma must not treat zero width
    // as an error.
    allowInvalidContainer: true,
    renderEdgeLabels: false,
    defaultEdgeColor: EDGE_COLOR,
    labelColor: { color: "#f2f2ee" },
    labelSize: 11,
    labelWeight: "400",
    labelFont: "ui-monospace, SFMono-Regular, Menlo, monospace",
    // Label the aggregates worth reading, not all of them: a wider grid cell
    // and a higher size floor keep the overview legible instead of overprinted.
    labelRenderedSizeThreshold: 13,
    labelGridCellSize: 170,
    labelDensity: 0.6,
    minCameraRatio: 0.05,
    maxCameraRatio: 12,
  });
  ovRenderer.on("clickNode", ({ node }) => showAggregate(node));
  ovRenderer.on("clickStage", () => {
    ovSelected = null;
    document.getElementById("panel").classList.remove("open");
  });
  ovRenderer.getCamera().animatedReset({ duration: 0 });
  fitOverview();
  buildLegend();
}

function fitOverview() {
  if (!ovGraph || !ovRenderer || !ovGraph.order) return;
  // Sigma frames the graph's own extent at ratio 1. Labels and node radii sit
  // outside that extent, so the fit needs headroom or the outer ring of
  // aggregates is clipped.
  ovRenderer.getCamera().setState({ x: 0.5, y: 0.5, angle: 0, ratio: 1.22 });
}

function confidenceWord(value) {
  return String(value || "").toLowerCase();
}

function showAggregate(key) {
  ovSelected = key;
  const attributes = ovGraph.getNodeAttributes(key);
  const panel = document.getElementById("panel");
  if (attributes._member) {
    showPanel(attributes._member);
    return;
  }
  const community = attributes._aggregate;
  const meta = communityMeta[community.id] || {};
  const cohesion = community.internalEdges + community.externalEdges
    ? Math.round((community.internalEdges / (community.internalEdges + community.externalEdges)) * 100)
    : 0;
  const representatives = community.representatives
    .map((id) => byId.get(id))
    .filter(Boolean)
    .map(
      (node) =>
        `<div class="callrow" data-node="${node.id}"><span class="cname">${escapeHtml(node.name)}</span><span class="cfile">${escapeHtml(node.file)}</span></div>`
    )
    .join("");
  const bundles = BUNDLES.filter((b) => b.a === community.id || b.b === community.id)
    .sort((left, right) => right.count - left.count)
    .slice(0, 6)
    .map((bundle) => {
      const other = bundle.a === community.id ? bundle.b : bundle.a;
      const otherMeta = communityMeta[other] || {};
      return `<div class="callrow"><span class="cname">${bundle.kind} &times;${bundle.count}</span><span class="cfile">${escapeHtml(otherMeta.label || "#" + other)}</span></div>`;
    })
    .join("");
  panel.innerHTML = `
    <h3>${escapeHtml(meta.label || community.label || "#" + community.id)}</h3>
    <p class="comm-chip"><span class="dot" style="background:${communityColor(community.id)}"></span>module aggregate</p>
    <dl class="agg-facts">
      <dt>symbols</dt><dd>${community.members.length}</dd>
      <dt>internal edges</dt><dd>${community.internalEdges}</dd>
      <dt>external edges</dt><dd>${community.externalEdges}</dd>
      <dt>cohesion</dt><dd>${cohesion}%</dd>
      <dt>entrypoints</dt><dd>${community.entrypoints}</dd>
      <dt>worst confidence</dt><dd>${confidenceWord(community.worstConfidence)}</dd>
    </dl>
    <div class="agg-actions">
      <button data-act="toggle">${State.expanded.has(community.id) ? "Collapse" : "Expand"} in place</button>
      <button data-act="isolate">${State.community === community.id ? "Show all modules" : "Isolate"}</button>
      <button data-act="explore">Explore this module</button>
    </div>
    ${representatives ? `<h4>Most connected</h4>${representatives}` : ""}
    ${bundles ? `<h4>Connects to</h4>${bundles}` : ""}
  `;
  panel.classList.add("open");
  panel.querySelector('[data-act="toggle"]').addEventListener("click", () => {
    const expanded = new Set(State.expanded);
    expanded.has(community.id) ? expanded.delete(community.id) : expanded.add(community.id);
    setState({ expanded });
  });
  panel.querySelector('[data-act="isolate"]').addEventListener("click", () => {
    setState({ community: State.community === community.id ? null : community.id });
  });
  panel.querySelector('[data-act="explore"]').addEventListener("click", () => {
    const target = byId.get(community.representatives[0]);
    setState({ mode: "explore", focus: target ? target.name : null, community: community.id }, { push: true });
  });
  for (const row of panel.querySelectorAll("[data-node]")) {
    row.addEventListener("click", () => {
      const node = byId.get(Number(row.dataset.node));
      if (node) setState({ mode: "explore", focus: node.name, community: community.id }, { push: true });
    });
  }
}

function buildLegend() {
  const host = document.getElementById("legend-list");
  const ranked = communityMeta
    .filter((m) => m.id !== UNGROUPED && m.size > 0)
    .slice()
    .sort((left, right) => right.size - left.size)
    .slice(0, 40);
  host.innerHTML = ranked
    .map(
      (m) =>
        `<div class="row${State.community === m.id ? " on" : ""}" data-c="${m.id}" title="${escapeHtml(m.name)}">` +
        `<span class="swatch" style="background:${communityColor(m.id)}"></span>` +
        `<span class="name">${escapeHtml(m.label)}</span><span class="n">${m.size}</span></div>`
    )
    .join("");
  for (const row of host.querySelectorAll(".row")) {
    row.addEventListener("click", () => {
      const id = Number(row.dataset.c);
      setState({ community: State.community === id ? null : id });
    });
  }
}

// --- Detail scene: built on first use ---------------------------------------
// The force layout over every symbol is the expensive part of this page. It
// runs when a mode actually needs it, so opening the page costs the Overview
// only.
let detailReady = false;
function ensureDetail() {
  if (detailReady) return;
  detailReady = true;
  initRenderer();
  buildTree();
  buildFilters();
  selectTab("explorer");
  runLayout(false);
}

let noticeTimer = null;
// A shared link can name a symbol that has since been renamed or deleted. Say
// so — degrading to a blank canvas silently is how a reader concludes the tool
// is broken.
function notice(message) {
  const host = document.getElementById("notice");
  if (!message) {
    host.hidden = true;
    return;
  }
  host.textContent = message;
  host.hidden = false;
  clearTimeout(noticeTimer);
  noticeTimer = setTimeout(() => { host.hidden = true; }, 6000);
}

function resolveFocus(value) {
  if (value === null || value === undefined) return null;
  const numeric = Number(value);
  if (Number.isInteger(numeric) && byId.has(numeric)) return byId.get(numeric);
  return (
    nodes.find((n) => n.file === value && n.kind === "file") ||
    nodes.find((n) => n.name === value) ||
    nodes.find((n) => n.file === value) ||
    null
  );
}

function applyState() {
  syncFilterSets();
  document.body.classList.toggle("mode-overview", State.mode === "overview");
  document.getElementById("legend").hidden = State.mode !== "overview";
  for (const button of document.querySelectorAll("#modes button")) {
    button.setAttribute("aria-selected", String(button.dataset.mode === State.mode));
  }
  if (State.mode === "overview") {
    buildOverview();
    buildLegend();
    if (ovRenderer) ovRenderer.refresh();
    return;
  }
  ensureDetail();
  const target = resolveFocus(State.focus);
  if (target) {
    notice(null);
    focusNode(target);
  } else if (State.focus) {
    notice(`No node named "${State.focus}" in this graph — showing everything instead.`);
  }
  refresh();
}

window.addEventListener("popstate", () => {
  readUrl();
  applyState();
});

document.addEventListener("keydown", (event) => {
  if (event.target.matches("input, textarea")) return;
  const index = Number(event.key);
  if (Number.isInteger(index) && index >= 1 && index <= MODE_IDS.length) {
    enterMode(MODE_IDS[index - 1]);
    return;
  }
  if (event.key === "Escape" && State.mode !== "overview") enterMode("overview");
});

// --- Bootstrap ----------------------------------------------------------------
{
  const fileCount = nodes.filter((n) => n.kind === "file").length;
  const repoName = "__REPO_NAME__";
  document.getElementById("repo-pill").innerHTML = `<b>${escapeHtml(repoName)}</b> · ${fileCount} files`;
  document.getElementById("c-nodes").textContent = nodes.length;
  document.getElementById("c-edges").textContent = links.length;
  document.getElementById("status-counts").textContent = `${nodes.length} nodes · ${links.length} edges · ${communityCount} modules`;
}
function visible(element) {
  return !!(element && element.offsetWidth && element.offsetHeight);
}
window.addEventListener("resize", () => {
  if (renderer && visible(document.getElementById("view"))) renderer.resize();
  if (ovRenderer && visible(document.getElementById("view-overview"))) ovRenderer.resize();
});
readUrl();
// A page opened with ?focus= (the wiki links back that way) means Explore.
if (!new URLSearchParams(location.search).has("mode") && new URLSearchParams(location.search).has("focus")) {
  State.mode = "explore";
}
buildModeSwitcher();
applyState();
writeUrl(false);
</script>
</body>
</html>
